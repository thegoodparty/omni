# Migration sync working area (never committed)
.sync-cache/

# Dependencies
node_modules/

# Build output
dist/
.next/
build/
coverage/

# Env (per-app .env files are intentionally untracked)
.env
.env.local
*.local

# Secret pipeline: ONLY the public key belongs in secrets/. A private key
# committed here would hand read access to every secret to anyone who can clone
# the repo, which is the one thing the pipeline exists to prevent. Ciphertext
# files (secrets/*.json) are committed on purpose — see docs/secrets.md.
secrets/*.pem
!secrets/*.pub.pem
secrets/*.key
secrets/*.env

# Local agent context (personal, not shared)
CLAUDE.local.md

# Logs / OS
*.log
.DS_Store

.claude/worktrees
docs/superpowers

# Agent worktrees and scratch artifacts (local only)
.worktrees/
scratch/
.playwright-mcp/

# Local briefing gallery data (dev-only; see app/dev/briefings + scripts/pull-local-briefings.sh)
.local-briefings/
.local-briefings-*/

# Local issue gallery data (dev-only; see app/dev/issues + scripts/pull-local-issues.sh)
.local-issues/
.local-issues-*/