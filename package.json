{
  "name": "omni",
  "version": "0.0.0",
  "private": true,
  "description": "GoodParty product monorepo (npm workspaces).",
  "license": "CC0-1.0",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": "22",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "sync": "bash scripts/sync-all.sh",
    "sync:repo": "bash scripts/sync-repo.sh",
    "migrate:pr": "bash scripts/migrate-pr.sh",
    "generate:prisma": "npm run generate:prisma:gp-api && npm run generate:prisma:election-api && npm run generate:prisma:people-api",
    "generate:prisma:gp-api": "npx prisma generate --schema=packages/gp-api/prisma/schema",
    "generate:prisma:election-api": "npx prisma generate --schema=packages/election-api/prisma/schema",
    "generate:prisma:people-api": "npx prisma generate --schema=packages/people-api/prisma/schema",
    "dev": "bash scripts/dev.sh",
    "ai-rules:update": "git submodule update --remote ai-rules",
    "postinstall": "git submodule update --init --recursive ai-rules || echo 'WARN: ai-rules submodule init failed - run: git submodule update --init --recursive ai-rules'"
  }
}
