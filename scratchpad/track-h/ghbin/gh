#!/bin/bash
case "$1 $2" in
  "pr diff") printf '%s\n' "${GH_STUB_FILES}" ;;
  *)
    case "$GH_STUB_MODE" in
      404) echo "gh: Not Found (HTTP 404)" >&2; exit 1 ;;
      403) echo "gh: Resource not accessible by integration (HTTP 403)" >&2; exit 1 ;;
    esac
    echo "${GH_STUB_PERM:-admin}"
    ;;
esac
