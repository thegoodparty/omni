# autopilot-bot prod variables
#
# The real non-secret values are committed in terraform.auto.tfvars — you do
# NOT need a hand-created terraform.tfvars to apply this environment. This
# example only documents the variables. The rollout runbook (README.md,
# ENG-11153) says when autopilot_list_ids gets its real value.

# Comma-separated ClickUp list IDs in scope. "" (the shipped state) means
# every webhook event 200-skips as "list not in scope" until the prod board
# decision is made and the webhook is registered.
autopilot_list_ids = ""

# ClickUp user id the human-actor gate treats as the bot's own writes.
autopilot_bot_user_id = "150125283"

# Slack channel id the epic supervisor posts stall/close-out alerts to
# (not a secret — a channel id, not a credential).
autopilot_slack_channel = "C0C1K9FBDG9"

# Private subnet IDs for the ECS tasks this Lambda launches.
# Default: the prod private subnets below (same ones pinned in
# ../pmf-engine-control-plane/main.tf and ../clickup-bot/main.tf).
private_subnet_ids = ["subnet-053357b931f0524d4", "subnet-0bb591861f72dcb7f"]
