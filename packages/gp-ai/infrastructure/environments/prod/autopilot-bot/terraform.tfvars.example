# autopilot-bot prod variables
#
# The defaults in main.tf are already correct for prod — you do NOT need a
# terraform.tfvars file to apply this environment. This example exists only
# to document the variables, and to show what to set once task 14 supplies
# real board IDs and prod rollout begins (ENG-11104).

# Comma-separated ClickUp list IDs in scope. Placeholder default "" means
# every webhook event 200-skips as "list not in scope" until this is set.
autopilot_list_ids = ""


# ClickUp user id the human-actor gate treats as the bot's own writes.
autopilot_bot_user_id = ""

# Slack channel id the epic supervisor posts stall/close-out alerts to
# (not a secret — a channel id, not a credential).
autopilot_slack_channel = ""

# Private subnet IDs for the ECS tasks this Lambda launches.
# Default: the prod private subnets below (same ones pinned in
# ../pmf-engine-control-plane/main.tf and ../clickup-bot/main.tf).
private_subnet_ids = ["subnet-053357b931f0524d4", "subnet-0bb591861f72dcb7f"]
