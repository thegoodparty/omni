LOG_LEVEL="debug" # Available levels: https://github.com/pinojs/pino/blob/main/docs/api.md#level-string

CORS_ORIGIN=http://localhost:4000

# Local dev + Prisma CLI (generate/migrate/seed) read this. Deployed environments
# ignore it and resolve the URL from SSM at runtime (see DatabaseUrlProvider).
LOCAL_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electiondb"

PORT=3002
PEOPLE_API_S2S_SECRET='some-secret'

S2S_ALLOW_LOCALHOST='false'
