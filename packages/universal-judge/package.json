{
  "name": "@goodparty_org/universal-judge",
  "version": "0.1.0",
  "private": true,
  "description": "Blind graded-pairwise A/B evaluation for GoodParty agents, foreground and background",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "judge": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/client-sqs": "^3.968.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
