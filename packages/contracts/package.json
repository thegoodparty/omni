{
  "name": "@goodparty_org/contracts",
  "version": "0.14.0",
  "description": "Shared Zod schemas and TypeScript types for the GoodParty API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-enums": "tsx scripts/generate-enums.ts",
    "ensure-built": "tsx scripts/ensure-built.cli.ts",
    "dev": "npm run generate-enums && tsup --watch",
    "build": "npm run generate-enums && tsup",
    "lint": "npm run generate-enums && eslint src",
    "typecheck": "npm run generate-enums && tsc --noEmit",
    "test": "npm run generate-enums && vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thegoodparty/gp-api"
  },
  "dependencies": {
    "validator": "^13.12.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@prisma/internals": "^6.19.0",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.8"
  }
}
