# =================================================================
# Authentication Configuration (Clerk)
# =================================================================

# Required: Clerk API Keys
# Get your keys from: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...

# Authentication Redirect URLs
# Note: Sign-up is disabled (invite-only). Users join via organization invitations.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"

# =================================================================
# GP API Configuration
# =================================================================

# Shared settings
GP_API_PROTOCOL=http
GP_API_PORT=3000
GP_API_ROOT_PATH='/v1'

# Per-environment domains
GP_DEV_API_DOMAIN=localhost
GP_PROD_API_DOMAIN=

# gp-admin authenticates to gp-api with this Vercel OIDC token. Vercel
# deployments get it per request. Locally, run `vercel link` and
# `vercel env pull` in packages/gp-admin to write it; every gp-api call
# fails without it.
VERCEL_OIDC_TOKEN=

# Clerk Org ID -> GP environment mapping
GP_ORG_ID_DEV=org_a
GP_ORG_ID_PROD=org_c

# =================================================================
# E2E Testing - Clerk Test User Credentials
# =================================================================
# Organizations: Development, Production
# Roles: org:admin, org:sales, org:read_only

# Development Environment
CLERK_TEST_DEV_ADMIN_EMAIL=tomer+dev-admin@goodparty.org
CLERK_TEST_DEV_ADMIN_PASSWORD=
CLERK_TEST_DEV_SALES_EMAIL=tomer+dev-sales@goodparty.org
CLERK_TEST_DEV_SALES_PASSWORD=
CLERK_TEST_DEV_READONLY_EMAIL=tomer+dev-readonly@goodparty.org
CLERK_TEST_DEV_READONLY_PASSWORD=

# Production Environment
CLERK_TEST_PROD_ADMIN_EMAIL=tomer+prod-admin@goodparty.org
CLERK_TEST_PROD_ADMIN_PASSWORD=
CLERK_TEST_PROD_SALES_EMAIL=tomer+prod-sales@goodparty.org
CLERK_TEST_PROD_SALES_PASSWORD=
CLERK_TEST_PROD_READONLY_EMAIL=tomer+prod-readonly@goodparty.org
CLERK_TEST_PROD_READONLY_PASSWORD=

# Multi-org user (admin in Dev, read_only in Prod)
CLERK_TEST_MULTI_ORG_EMAIL=tomer+multi-org@goodparty.org
CLERK_TEST_MULTI_ORG_PASSWORD=

# =================================================================
# GP Webapp URL (for impersonation redirect)
# =================================================================
NEXT_PUBLIC_GP_DEV_WEBAPP_URL=http://localhost:4000
NEXT_PUBLIC_GP_WEBAPP_URL=http://localhost:4000

# =================================================================
# Observability / misc
# =================================================================
# Opts the outreach-results dashboard into sample data while gp-api's real
# endpoints don't exist yet. Set to 1 to enable locally.
OUTREACH_RESULTS_FIXTURES=
# Platform-set (Playwright config, CI runner, Next.js) — not set by hand.
BASE_URL=
CI=
NEXT_RUNTIME=

# =================================================================
# Notes:
# =================================================================
# 1. Copy this file to '.env.local' for local development
# 2. Never commit the actual '.env.local' file to version control
