model OutreachEmailList {
  id                       Int                       @id @default(autoincrement())
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  senderId                 Int                       @map("sender_id")
  sender                   OutreachEmailSender       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  name                     String
  sourceFileKey            String                    @map("source_file_key")
  status                   OutreachEmailListStatus   @default(queued)
  importCursor             Int                       @default(0) @map("import_cursor")
  importAttempts           Int                       @default(0) @map("import_attempts")
  importClaimedAt          DateTime?                 @map("import_claimed_at")
  importError              String?                   @map("import_error")
  rowCount                 Int                       @default(0) @map("row_count")
  validCount               Int                       @default(0) @map("valid_count")
  invalidCount             Int                       @default(0) @map("invalid_count")
  duplicateCount           Int                       @default(0) @map("duplicate_count")
  suppressedCount          Int                       @default(0) @map("suppressed_count")
  consentConfirmedAt       DateTime                  @map("consent_confirmed_at")
  consentConfirmedByUserId Int                       @map("consent_confirmed_by_user_id")
  members                  OutreachEmailListMember[]
  sends                    OutreachEmail[]

  @@index([senderId])
  @@index([status, importClaimedAt])
  @@map("outreach_email_list")
}

enum OutreachEmailListStatus {
  queued
  importing
  ready
  failed
}
