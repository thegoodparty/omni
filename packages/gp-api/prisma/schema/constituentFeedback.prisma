// The channel a piece of feedback arrived through. Door knocking and phone
// banking are the first two, not the definition — a poll response and an
// inbound constituent form are the same object with a different provenance —
// so this grows rather than the table forking.
enum ConstituentFeedbackChannel {
  door_knock
  phone_bank
}

// Where the constituent stands on the issue they named. Deliberately NOT
// SupportAnswer: that asks whether someone supports a candidate, which is a
// question an elected official's canvasser never asks. `mixed` is a settled
// position with reservations; `unclear` is the absence of one.
enum ConstituentFeedbackStance {
  supports
  opposes
  mixed
  unclear
}

// `dictation_offline` is a memo the phone recorded with no signal and
// uploaded later: the server transcribed it, nobody saw the words live.
enum ConstituentFeedbackCaptureMethod {
  dictation
  typed
  dictation_offline
}

// `extracted` means a model produced the issues, not that anyone agreed with
// them — `confirmedAt` is the only column that says a human saw it. `failed`
// covers a refusal or a malformed response; the transcript survives either
// way, so nothing recorded in the field is ever lost to an extraction error.
enum ConstituentFeedbackExtractionStatus {
  pending
  extracted
  failed
}

// How a memo came to be confirmed. `reviewed`: the person who was there
// accepted or corrected the issues. `skipped`: they passed on the check, so
// it holds no issues. `automatic`: nobody could check it (a recording
// transcribed later, or a confirm step abandoned), so it holds no issues
// either. Only `reviewed` carries issues a person stood behind.
enum ConstituentFeedbackConfirmation {
  reviewed
  skipped
  automatic
}

// What a canvasser or caller recorded about one conversation with one
// constituent: a short spoken summary in THEIR voice, plus the issues
// extracted from it, each with a stance and an outcome
// (`ConstituentFeedbackIssue`).
//
// The voice on the recording is the official's, never the constituent's, and
// that is a deliberate design constraint rather than an implementation
// detail. It keeps two-party-consent law out of the feature entirely, and it
// means every row is an official's characterization of a named resident —
// which is very likely a public record, so treat it as disclosable.
//
// There is no issue catalog behind `issueLabel`. Topics are derived from the
// corpus during synthesis, not authored before a canvass, so this table and
// its issues are the whole data model for the collection phase.
model ConstituentFeedback {
  id               String       @id @default(uuid(7))
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  organizationSlug String       @map("organization_slug")
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)
  personId         String       @map("person_id")
  occurredAt       DateTime     @map("occurred_at")

  // Required, unlike the nullable `actorUserId` on the interaction tables.
  // Those backfilled nothing and render authorless rows; this column has no
  // legacy rows to accommodate, and an unattributed characterization of a
  // named resident is not a record worth keeping.
  actorUserId Int  @map("actor_user_id")
  actor       User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  channel ConstituentFeedbackChannel

  // Exactly one is set, matching `channel`, enforced by the contract rather
  // than a CHECK — the same call the knock contract makes about its two
  // answer vocabularies. Unique because a re-record corrects in place instead
  // of forking, matching how both interaction tables upsert.
  doorKnockInteractionId String?                      @unique @map("door_knock_interaction_id")
  doorKnockInteraction   ContactInteractionDoorKnock? @relation(fields: [doorKnockInteractionId], references: [id], onDelete: Cascade)

  phoneBankingInteractionId String?                         @unique @map("phone_banking_interaction_id")
  phoneBankingInteraction   ContactInteractionPhoneBanking? @relation(fields: [phoneBankingInteractionId], references: [id], onDelete: Cascade)

  // The recorded summary. Nullable because dictation can fail after the knock
  // itself has already saved, and a row with a failed memo is a more honest
  // record than no row at all.
  transcript    String?                          @db.Text
  captureMethod ConstituentFeedbackCaptureMethod @map("capture_method")

  // The offline path's recording in the speech bucket. Null on a memo
  // dictated live: that streams to Transcribe over a socket and no audio is
  // persisted anywhere.
  audioKey String? @map("audio_key")

  // The batch Transcribe job turning `audioKey` into `transcript`, kept so
  // the pending-transcription cron can poll it. Null until a job starts.
  transcriptionJobName String? @map("transcription_job_name")

  // Transcribe jobs started, or tried, for this recording. The cron starts
  // another after a failed one until the cap, then marks the memo failed.
  transcriptionAttempts Int @default(0) @map("transcription_attempts")

  extractionStatus     ConstituentFeedbackExtractionStatus @default(pending) @map("extraction_status")
  extractionConfidence Float?                              @map("extraction_confidence")
  extractionModel      String?                             @map("extraction_model")

  // The issues, each with a stance and an outcome: the model's proposal
  // until `confirmedAt` is set, then what the canvasser accepted or
  // corrected.
  issues ConstituentFeedbackIssue[]

  // The effort's question as it stood when this row was extracted.
  // Denormalized because the question can be edited afterwards and an
  // extraction has to stay readable against the prompt it actually ran with.
  effortQuestion String? @map("effort_question") @db.Text

  // Set when the memo is confirmed, in any of the three ways
  // `confirmation` names. Null means it waits on that step, and no rollup
  // counts it. Its words reach synthesis once it is set; its issues are
  // only ever ones a person reviewed.
  confirmedAt  DateTime?                        @map("confirmed_at")
  confirmation ConstituentFeedbackConfirmation?

  // What the model proposed for a memo confirmed without review, kept only
  // to measure extraction. Apart from `issues` so nothing that reads a
  // memo's issues can count an unreviewed guess.
  unreviewedProposal ConstituentFeedbackUnreviewedIssue[]

  // Replay idempotency for a dead-zone retry, the same contract the knock
  // payload's `clientKey` carries: the same key upserts the same row.
  clientKey String @map("client_key")

  // The effort this conversation belonged to, on either channel. Resolved
  // at capture time from stopTargetId (knock) or entryId (call). SetNull so
  // deleting an effort keeps what the person said on their record.
  outreachId Int?      @map("outreach_id")
  outreach   Outreach? @relation(fields: [outreachId], references: [id], onDelete: SetNull)

  tags         ConstituentFeedbackTag[]
  themeMembers FeedbackThemeMember[]

  @@unique([organizationSlug, clientKey])
  @@index([organizationSlug, personId, occurredAt])
  @@index([organizationSlug, actorUserId])
  // The collection-phase read: everything awaiting or missing an extraction.
  @@index([organizationSlug, extractionStatus])
  @@index([organizationSlug, outreachId])
  // The pending-transcription cron reads across orgs, and pending rows are few.
  @@index([extractionStatus])
  // The abandoned-confirm sweep reads across orgs every minute, oldest
  // unconfirmed first.
  @@index([confirmedAt, updatedAt])
  @@map("constituent_feedback")
}

// One issue the person raised in one conversation. A memo holds up to five,
// in the order the model heard them; most hold one.
model ConstituentFeedbackIssue {
  id         String              @id @default(uuid(7))
  createdAt  DateTime            @default(now()) @map("created_at")
  feedbackId String              @map("feedback_id")
  feedback   ConstituentFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  position   Int

  // Confirmed values: what the canvasser accepted or corrected.
  issueLabel     String                     @map("issue_label")
  stance         ConstituentFeedbackStance?
  desiredOutcome String?                    @map("desired_outcome") @db.Text

  // What the model proposed before a human touched it. Null on an issue a
  // human added or rewrote from scratch. `proposedStance` is free text, as on
  // the memo row today.
  proposedIssueLabel     String? @map("proposed_issue_label")
  proposedStance         String? @map("proposed_stance")
  proposedDesiredOutcome String? @map("proposed_desired_outcome") @db.Text

  themes FeedbackThemeIssue[]

  @@unique([feedbackId, position])
  @@map("constituent_feedback_issue")
}

// One issue the model proposed on a memo nobody reviewed: skipped at the
// door, or confirmed automatically. Raw model output, measurement only;
// nothing outside tests reads it.
model ConstituentFeedbackUnreviewedIssue {
  id             String              @id @default(uuid(7))
  createdAt      DateTime            @default(now()) @map("created_at")
  feedbackId     String              @map("feedback_id")
  feedback       ConstituentFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  position       Int
  issueLabel     String              @map("issue_label")
  // Free text, as the model said it, like `proposedStance`.
  stance         String?
  desiredOutcome String?             @map("desired_outcome") @db.Text

  @@unique([feedbackId, position])
  @@map("constituent_feedback_unreviewed_issue")
}
