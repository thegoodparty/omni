model LocalNewsCache {
  id String @id @default(uuid(7))

  office String
  // Normalized to "" (never null) so the (office, city, state) compound
  // unique behaves as a real key — Postgres treats NULLs as distinct, which
  // would let duplicate city-less rows slip past the constraint.
  city  String @default("")
  state String

  // 'pending' | 'ready'
  status String
  // Epoch ms when the pending fetch was claimed; powers the pending TTL.
  // Null once the row is 'ready'.
  startedAt BigInt? @map("started_at")

  /// [LocalMediaOutlet[]]
  outlets Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([office, city, state], name: "jurisdiction")
  @@map("local_news_cache")
}
