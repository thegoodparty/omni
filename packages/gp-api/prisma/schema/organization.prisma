model Organization {
  createdAt                       DateTime                         @default(now()) @map("created_at")
  updatedAt                       DateTime                         @default(now()) @updatedAt @map("updated_at")
  slug                            String                           @id
  owner                           User                             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId                         Int                              @map("owner_id")
  positionId                      String?                          @map("position_id")
  overrideDistrictId              String?                          @map("override_district_id")
  customPositionName              String?                          @map("custom_position_name")
  // Cutoff for run-derived data that has no row to delete. Set whenever the
  // org's office identity (positionId / overrideDistrictId) changes, so reads
  // that resolve an artifact from the newest COMPLETED run ignore runs that
  // predate the change. See ElectedOfficeService.onOfficeIdentityWritten.
  officeIdentityChangedAt         DateTime?                        @map("office_identity_changed_at")
  campaign                        Campaign?
  electedOffice                   ElectedOffice?
  voterFileFilters                VoterFileFilter[]
  experimentRuns                  ExperimentRun[]
  artifactFeedbacks               ArtifactFeedback[]
  communityIssues                 CommunityIssue[]
  ordinanceCodeRecord             OrdinanceCodeRecord?
  outreaches                      Outreach[]
  contactNotes                    ContactNote[]
  contactInteractionDoorKnocks    ContactInteractionDoorKnock[]
  contactInteractionTexts         ContactInteractionText[]
  contactInteractionRobocalls     ContactInteractionRobocall[]
  contactInteractionPhoneBankings ContactInteractionPhoneBanking[]
  phoneBankingLists               PhoneBankingList[]
  phoneBankingSuppressedPhones    PhoneBankingSuppressedPhone[]
  peerlyPhoneLists                PeerlyPhoneList[]
  contactStatusEvents             ContactStatusEvent[]
  contactCurrentStatuses          ContactCurrentStatus[]

  @@index([ownerId])
  @@map("organization")
}
