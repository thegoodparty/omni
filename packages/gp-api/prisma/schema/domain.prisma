enum DomainStatus {
  pending
  submitted
  registered
  active
  inactive
}

enum DomainSource {
  manual
  agentic
}

model Domain {
  id                      Int          @id @default(autoincrement())
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")
  name                    String       @unique
  websiteId               Int          @unique @map("website_id")
  website                 Website      @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  status                  DomainStatus @default(pending)
  source                  DomainSource @default(manual)
  operationId             String?      @map("operation_id")
  price                   Decimal?
  paymentId               String?      @map("payment_id")
  emailForwardingDomainId String?      @map("email_forwarding_domain_id")
  registrantVerifiedAt    DateTime?    @map("registrant_verified_at")
  // The registrar's own verdict when it refused the purchase order. Written
  // with the refused order id (operationId) and status inactive, so a retry
  // of the same name answers the same terminal refusal instead of placing a
  // second order. Every path that places a new order, and every order that
  // completes, clears them: they only describe a refusal this row has not
  // moved past.
  registrarRefusalCode    String?      @map("registrar_refusal_code")
  registrarRefusedAt      DateTime?    @map("registrar_refused_at")

  @@map("domain")
}
