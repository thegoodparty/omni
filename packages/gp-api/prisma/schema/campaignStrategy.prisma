model CampaignStrategy {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId Int      @unique @map("campaign_id")

  oppositionRunId    String? @map("opposition_run_id")
  opportunitiesRunId String? @map("opportunities_run_id")

  // Lifetime dispatch count per section. A failed/stuck section re-dispatches on
  // the next call (so a user can just retry), capped by MAX_SECTION_ATTEMPTS in
  // the service to bound runaway Fargate spend from a deterministic failure or a
  // client hammering the endpoint.
  oppositionAttempts    Int @default(0) @map("opposition_attempts")
  opportunitiesAttempts Int @default(0) @map("opportunities_attempts")

  // Set in the same transaction that writes each section's rows. The endpoint
  // gates 'ready' on these (not on run status) so a poll between a run being
  // marked COMPLETED and its rows landing can't return a hollow 'ready'.
  oppositionPersistedAt    DateTime? @map("opposition_persisted_at")
  opportunitiesPersistedAt DateTime? @map("opportunities_persisted_at")

  // Stamped when a generation kicks off on an otherwise-idle plan (and reset on
  // each fresh attempt/retry), so the user-perceived duration is the later of
  // the two persistedAt markers minus this. Unlike createdAt (set once on first
  // endpoint hit), this tracks the trigger that produced the current result.
  generationStartedAt DateTime? @map("generation_started_at")

  // The BR race hash this row's content was generated for. Compared against
  // campaign.details.raceId on every read; a mismatch (office change) resets
  // the content in place and regenerates, instead of forever serving the
  // first race that happened to trigger generation. Nullable only for the
  // pre-stamp backfill window — new rows are stamped at creation.
  raceId String? @map("race_id")

  // Every race hash this row generated for before the current one, oldest
  // first. Appended on each race-change reset; length = office-change count.
  previousRaceIds String[] @default([]) @map("previous_race_ids")

  // Whether this row's content was generated with a complete campaign story.
  // The story is optional, so a plan can be generated without one; when the
  // candidate later finishes their story the plan is stale in a way no raceId
  // comparison would catch. Compared against current story completeness on
  // every read, and a false->true transition resets the content in place and
  // regenerates (see alignPlanWithStory). One-shot: it is the claim, so
  // concurrent polls can't both regenerate.
  //
  // SUPERSEDED by storyFingerprint below, and kept only to tell two legacy
  // rows apart: a plan generated from a story (true) must adopt the current
  // fingerprint silently, while a plan generated without one (false) must
  // regenerate. Once every row carries a fingerprint this column is dead and
  // can be dropped.
  generatedWithStory Boolean @default(false) @map("generated_with_story")

  // Digest of the story content this plan was last generated from, and the
  // compare-and-swap claim that replaces the boolean above. Null means never
  // generated from a story. Regeneration fires whenever the current story
  // hashes to something else, so editing an answer re-runs the plan while
  // saving the same answer twice does not — which the boolean could not
  // express, because once true it was true forever.
  storyFingerprint String? @map("story_fingerprint")

  // One-shot claim that guards the initial campaign-tracker bootstrap. Both
  // plan sections complete on independent SQS messages (possibly different
  // pods); the first to flip this false->true in a single conditional update
  // wins the right to materialize static rows + dispatch the initial CAP run,
  // so concurrent completions can't double-dispatch.
  trackerBootstrapped Boolean @default(false) @map("tracker_bootstrapped")

  // One-shot claim for the CAS outreach-schedule Slack post (the message the
  // ClickUp automation turns into voter-contact tasks). Claimed before posting
  // so the generation-1 and Pro-upgrade triggers can't both post; released on
  // a failed send so a later trigger retries.
  outreachSlackPostedAt DateTime? @map("outreach_slack_posted_at")

  opportunities CampaignStrategyOpportunity[]
  challenges    CampaignStrategyChallenge[]
  opponents     CampaignStrategyOpponent[]

  @@index([oppositionRunId])
  @@index([opportunitiesRunId])
  @@map("campaign_strategy")
}
