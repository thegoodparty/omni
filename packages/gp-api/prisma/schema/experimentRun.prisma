enum ExperimentRunStatus {
  QUEUED
  RUNNING
  AWAITING_RESUME
  COMPLETED
  FAILED
  SUPERSEDED
}

model ExperimentRun {
  runId String @unique @default(uuid(7)) @map("run_id")

  organizationSlug String       @map("organization_slug")
  organization     Organization @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  // e.g. "district_intel"
  experimentType String @map("experiment_type")

  // Default stays RUNNING: Postgres forbids using a freshly-added enum value
  // (QUEUED) in the same transaction it's added, and the test harness applies
  // all migrations in one transaction — a SET DEFAULT 'QUEUED' migration trips
  // 55P04. Every create path sets status explicitly, so the column default is
  // cosmetic.
  status ExperimentRunStatus @default(RUNNING)

  // 'HIGH' | 'DEFAULT' — persisted so a resumed run keeps its original priority
  // instead of silently dropping to DEFAULT.
  priority String @default("DEFAULT")

  params Json @default("{}") @db.JsonB

  artifactBucket  String? @map("artifact_bucket")
  artifactKey     String? @map("artifact_key")
  durationSeconds Float?  @map("duration_seconds")
  costUsd         Float?  @map("cost_usd")
  error           String?
  stage              String?   @map("stage")
  dataQuality        String?   @map("data_quality")
  resumeScheduledFor DateTime? @map("resume_scheduled_for")
  resumeAttempts     Int       @default(0) @map("resume_attempts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  meetingBriefings         MeetingBriefing[]
  meetingResourceLocations MeetingResourceLocation[]
  userAgendaUploads        UserAgendaUpload[]
  ordinanceCodeRecords     OrdinanceCodeRecord[]

  @@index([organizationSlug, experimentType])
  @@index([status, resumeScheduledFor])
  @@index([experimentType, status])
  @@map("experiment_run")
}
