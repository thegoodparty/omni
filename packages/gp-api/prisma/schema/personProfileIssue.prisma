// Per-issue publication overlay for a PersonProfile. The underlying issue data
// lives on Priority (the Serve issue/priority the office holder authored); this
// row only records the owner's publication decisions for the public profile:
// whether to show it, its transparency level, and its display order.
model PersonProfileIssue {
  id              String        @id @default(uuid(7))
  personProfileId String        @map("person_profile_id")
  personProfile   PersonProfile @relation(fields: [personProfileId], references: [id], onDelete: Cascade)

  issueId  String   @map("issue_id")
  priority Priority @relation(fields: [issueId], references: [id], onDelete: Cascade)

  visible      Boolean @default(true)
  transparency String?
  sortOrder    Int?    @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([personProfileId, issueId])
  @@index([personProfileId])
  @@map("person_profile_issue")
}
