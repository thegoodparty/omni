// Storage vocabulary for PhoneBankingCreateSchema's purpose. Contracts'
// OUTREACH_PURPOSE_VALUES (the canonical vocabulary shared by every outreach
// channel) is already snake_case, so these labels match the wire values
// directly — no service-layer mapping.
enum PhoneBankingPurpose {
  introduce_myself
  persuade_voters
  event_invite
  early_voting
  election_day_turnout
  custom
  // Serve-only purposes (ENG-10985).
  explain_decision
  community_input
  share_resource
}

model PhoneBankingList {
  id                              Int                              @id @default(autoincrement())
  createdAt                       DateTime                         @default(now()) @map("created_at")
  updatedAt                       DateTime                         @updatedAt @map("updated_at")
  organizationSlug                String                           @map("organization_slug")
  organization                    Organization                     @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)
  // Deleting a filter never deletes the list or its person rows — used
  // filters are delete-locked at the app layer instead, so this relation
  // carries no onDelete: Cascade.
  voterFileFilter                 VoterFileFilter                  @relation(fields: [voterFileFilterId], references: [id])
  voterFileFilterId               Int                              @map("voter_file_filter_id")
  name                            String
  script                          String                           @db.Text
  sheetCount                      Int                              @map("sheet_count") @db.SmallInt
  purpose                         PhoneBankingPurpose
  // The specific thing this effort is asking constituents, set on the wizard
  // step that follows a `community_input` purpose and required there. Gives
  // issue capture's extraction the context it needs to read an answer, the
  // same column door knocking's turf carries for the same reason. Null on
  // every other purpose, and on every list frozen before this shipped.
  communityInputQuestion          String?                          @map("community_input_question") @db.Text
  entries                         PhoneBankingListEntry[]
  outreach                        Outreach?
  contactInteractionPhoneBankings ContactInteractionPhoneBanking[]

  @@index([organizationSlug])
  @@map("phone_banking_list")
}
