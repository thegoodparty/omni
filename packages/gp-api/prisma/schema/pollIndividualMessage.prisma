enum PollIndividualMessageSender {
  ELECTED_OFFICIAL
  CONSTITUENT
}

model PollIndividualMessage {
  id              String                      @id
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @default(now()) @updatedAt @map("updated_at")
  personId        String                      @map("person_id")
  personCellPhone String?                     @map("person_cell_phone")
  sentAt          DateTime                    @map("sent_at")
  isOptOut        Boolean?                    @map("is_opt_out")
  sender          PollIndividualMessageSender @default(ELECTED_OFFICIAL) @map("sender")
  content         String?                     @map("content") // The message itself

  // Relations
  electedOffice   ElectedOffice? @relation(fields: [electedOfficeId], references: [id], onDelete: Cascade)
  electedOfficeId String?        @map("elected_office_id")
  // Exactly one of pollId / outreachId is set (DB CHECK, see migration
  // generalize_poll_individual_message). A message belongs to a poll or to a
  // text outreach, never both. This is the only place in the schema that
  // stores inbound SMS text, so both products need it: the Win inbound sweep
  // records timestamps on ContactInteractionText and never the body.
  poll            Poll?          @relation(fields: [pollId], references: [id], onDelete: Cascade)
  pollId          String?        @map("poll_id")
  outreach        Outreach?      @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  outreachId      Int?           @map("outreach_id")
  pollIssues      PollIssue[]

  @@index([electedOfficeId, personId, sentAt])
  @@index([electedOfficeId, pollId, personCellPhone])
  // The outreach-side twin of the poll lookup above: resolve an inbound
  // reply's number to the person it was sent to.
  @@index([electedOfficeId, outreachId, personCellPhone])
  @@map("poll_individual_message")
}
