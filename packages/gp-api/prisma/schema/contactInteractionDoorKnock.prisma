// Vocabulary locked by the 2026-07-15 CRM designs — exactly three-way.
enum SupportAnswer {
  supporter
  unsure
  non_supporter
}

enum DoorKnockOutcome {
  answered
  not_home
  refused_to_engage
  // Door-knocking-tool additions (July 2026): flattened end-states from the
  // canvasser question flow. Additive — CRM readers unaffected.
  inaccessible
  not_a_voter
}

enum WillVoteAnswer {
  yes
  no
  unsure
}

// The Serve door's terminal answer, in place of support and will-vote. Binary
// where those are three-way because there is no Serve equivalent of "unsure":
// support is a stance a resident may not have settled on, while follow-up is
// something a canvasser either committed to or did not.
enum FollowUpAnswer {
  yes
  no
}

model ContactInteractionDoorKnock {
  id               String           @id @default(uuid(7))
  createdAt        DateTime         @default(now()) @map("created_at")
  organizationSlug String           @map("organization_slug")
  organization     Organization     @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)
  personId         String           @map("person_id")
  occurredAt       DateTime         @map("occurred_at")
  outcome          DoorKnockOutcome
  supportAnswer    SupportAnswer?   @map("support_answer")
  // GOTV signal captured by the door-knocking tool; null on manual/legacy
  // rows and unused by the feed until it wants it.
  willVote         WillVoteAnswer?  @map("will_vote")
  // The Serve surface's answer, and the only one it captures: an elected
  // official's canvasser is not asking a constituent about support or turnout.
  // Mutually exclusive with `supportAnswer` in practice — one surface's
  // vocabulary per row, enforced by the contract rather than by the database,
  // since a CHECK constraint would also have to be taught about every legacy
  // row that predates it.
  followUp         FollowUpAnswer?  @map("follow_up")
  note             String?
  // The door-knocking tool's route/interaction id, the idempotency key so a
  // re-sync upserts rather than double-writes. Null for manual logs; Postgres
  // treats NULLs as distinct so the unique index never collides those rows.
  sourceId         String?          @map("source_id")
  manual           Boolean          @default(false)
  // The caller (manual log) or canvasser (tool sync) who logged this row.
  // Null on rows written before this column existed (no backfill) — the
  // feed renders those authorless.
  actorUserId      Int?             @map("actor_user_id")
  actor            User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationSlug, sourceId])
  @@index([organizationSlug, personId, occurredAt])
  @@index([organizationSlug, actorUserId])
  @@map("contact_interaction_door_knock")
}
