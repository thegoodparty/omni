model DoorKnockingStop {
  id                  Int                    @id @default(autoincrement())
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  route               DoorKnockingRoute      @relation(fields: [doorKnockingRouteId], references: [id], onDelete: Cascade)
  doorKnockingRouteId Int                    @map("door_knocking_route_id")
  // Geoapify visit order, joined back by the opaque job ids we minted.
  seq                 Int                    @db.SmallInt
  lat                 Float
  lng                 Float
  // Copied verbatim from Residence_Addresses_AddressLine at the freeze —
  // people_db's own display format, never invented here.
  displayAddress      String                 @map("display_address")
  legSeconds          Int                    @map("leg_seconds")
  legMeters           Int                    @map("leg_meters")
  targets             DoorKnockingStopTarget[]

  @@unique([doorKnockingRouteId, seq])
  @@map("door_knocking_stop")
}
