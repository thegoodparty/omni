model Ecanvasser {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  apiKey     String   @map("api_key")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId Int      @unique @map("campaign_id")

  contacts     EcanvasserContact[]
  interactions EcanvasserInteraction[]
  houses       EcanvasserHouse[]

  lastSync DateTime? @map("last_sync")
  error    String?

  @@index([campaignId])
  @@map("ecanvasser")
}

model EcanvasserContact {
  id                Int              @id @default(autoincrement())
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  // eCanvasser API contact id (stable across re-syncs, unlike the local
  // autoincrement id which a full re-sync regenerates). Lets attribution join
  // an interaction (which carries the API contact id) back to its contact.
  externalId        Int?             @map("external_id")
  firstName         String           @map("first_name")
  lastName          String           @map("last_name")
  type              String
  gender            String?
  dateOfBirth       DateTime?        @map("date_of_birth")
  yearOfBirth       String?          @map("year_of_birth")
  houseId           Int?             @map("house_id")
  uniqueIdentifier  String?          @map("unique_identifier")
  organization      String?
  volunteer         Boolean          @default(false)
  deceased          Boolean          @default(false)
  donor             Boolean          @default(false)
  homePhone         String?          @map("home_phone")
  mobilePhone       String?          @map("mobile_phone")
  email             String?
  actionId          Int?             @map("action_id")
  lastInteractionId Int?             @map("last_interaction_id")
  createdBy         Int              @map("created_by")
  ecanvasser        Ecanvasser       @relation(fields: [ecanvasserId], references: [id], onDelete: Cascade)
  ecanvasserId      Int              @map("ecanvasser_id")
  EcanvasserHouse   EcanvasserHouse? @relation(fields: [ecanvasserHouseId], references: [id])
  ecanvasserHouseId Int?

  @@unique([ecanvasserId, externalId])
  @@index([ecanvasserId])
  @@map("ecanvasser_contact")
}

model EcanvasserHouse {
  id           Int                 @id @default(autoincrement())
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  // eCanvasser API house id (stable across re-syncs, unlike the local
  // autoincrement id which a full re-sync regenerates). Keys the upsert so an
  // overlapping sync window updates the house in place instead of duplicating.
  externalId   Int?                @map("external_id")
  address      String
  latitude     Float?
  longitude    Float?
  ecanvasser   Ecanvasser          @relation(fields: [ecanvasserId], references: [id], onDelete: Cascade)
  ecanvasserId Int                 @map("ecanvasser_id")
  contacts     EcanvasserContact[]

  @@unique([ecanvasserId, externalId])
  @@index([ecanvasserId])
  @@map("ecanvasser_house")
}

model EcanvasserInteraction {
  id           Int        @id @default(autoincrement())
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  // eCanvasser API interaction id. Stable across re-syncs (the local id is not),
  // so it is the idempotency key for the emitted VoterOutreachActivity.
  externalId   Int?       @map("external_id")
  type         String
  rating       Int?
  date         DateTime   @default(now()) @map("date")
  status       String     @default("Active")
  contactId    Int        @map("contact_id")
  createdBy    Int        @map("created_by")
  notes        String?
  source       String?
  ecanvasser   Ecanvasser @relation(fields: [ecanvasserId], references: [id], onDelete: Cascade)
  ecanvasserId Int        @map("ecanvasser_id")

  @@unique([ecanvasserId, externalId])
  @@index([ecanvasserId])
  @@map("ecanvasser_interaction")
}
