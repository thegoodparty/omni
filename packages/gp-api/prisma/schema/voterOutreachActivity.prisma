// DEPRECATED — replaced by the ContactInteraction* models (see
// prisma/schema/contactInteraction*.prisma) per the CRM tech design:
// https://app.clickup.com/90132012119/v/dc/2ky4jq2q-20493/2ky4jq2q-98973
// No new write paths may target this model. The existing segment-derived
// send-attribution writes keep running until feature 5 moves them over.
//
// Per-voter outreach attribution for Win campaigns. Each row records one outreach
// event experienced by one voter, keyed on the durable L2 id (lalVoterId) rather
// than the people-api personId so attribution survives people-api id changes.
// Kept separate from PollIndividualMessage, which is elected-office / poll-specific.
//
// Per-channel attribution granularity (see attributionSource):
//   recipient      — per-recipient data exists for this voter: doorKnocking, p2p.
//   segmentDerived — inferred from a segment-level send with no per-recipient
//                    confirmation: text, phoneBanking, socialMedia, robocall.
// Write paths (epic tasks 13–15) set the source so the person timeline (task 16)
// can label send-time attribution honestly.
enum VoterOutreachAttributionSource {
  recipient
  segmentDerived
}

model VoterOutreachActivity {
  id                Int                            @id @default(autoincrement())
  createdAt         DateTime                       @default(now()) @map("created_at")
  updatedAt         DateTime                       @default(now()) @updatedAt @map("updated_at")
  campaign          Campaign                       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId        Int                            @map("campaign_id")
  lalVoterId        String                         @map("lal_voter_id")
  outreachType      OutreachType                   @map("outreach_type")
  attributionSource VoterOutreachAttributionSource @map("attribution_source")
  occurredAt        DateTime                       @map("occurred_at")
  // Stable id of the upstream source event this activity was emitted from
  // (e.g. the eCanvasser interaction id for door knocking), used as the
  // idempotency key so a re-sync upserts rather than double-writes. Null for
  // write paths with no per-event source id (segment-derived sends). Postgres
  // treats NULLs as distinct, so the unique index never collides those rows.
  sourceId          String?                        @map("source_id")
  // Optional link to the segment-level Outreach this activity was derived from.
  outreach          Outreach?                      @relation(fields: [outreachId], references: [id])
  outreachId        Int?                           @map("outreach_id")
  // Using Json for per-channel attribution context whose shape is defined by the
  // write paths (epic tasks 13–15) and varies by outreachType — genuinely dynamic.
  metadata          Json?                          @db.JsonB

  // Recipient write paths (epic task 13, door knocking) dedupe on the upstream
  // source-event id so a re-sync upserts rather than double-writes.
  @@unique([campaignId, outreachType, sourceId])
  // One activity per voter per source outreach. Lets the segment-derived write
  // paths (epic task 15) emit idempotently via createMany(skipDuplicates) so a
  // re-launch/retry of the same Outreach can't double-tag a voter. Rows with a
  // null outreachId (recipient paths that aren't outreach-linked) are exempt —
  // Postgres treats nulls as distinct, so they're never deduped here.
  @@unique([outreachId, lalVoterId])
  @@index([campaignId, lalVoterId, occurredAt])
  @@map("voter_outreach_activity")
}
