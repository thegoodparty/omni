model CommunityIssueFeed {
  id               String             @id @default(uuid(7))
  organizationSlug String             @map("organization_slug")
  organization     Organization       @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)

  list     CommunityIssueFeedList
  category CommunityIssueFeedCategory
  priority CommunityIssueFeedPriority
  title    String
  summary  String                     @db.Text
  detail   Json?                      @db.JsonB
  rank     Int?

  archivedAt         DateTime? @map("archived_at")
  lastRefreshedRunId String?   @map("last_refreshed_run_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  priorities        Priority[]
  briefingItemLinks MeetingBriefingItemLink[]

  @@index([organizationSlug, list, archivedAt, rank])
  @@map("community_issue_feed")
}

enum CommunityIssueFeedList {
  top_community
  trending
}

enum CommunityIssueFeedCategory {
  infrastructure_and_transportation
  public_safety
  education
  housing_and_development
  health_and_human_services
  economic_development
  quality_of_life
  government_operations
  other
}

enum CommunityIssueFeedPriority {
  low
  medium
  high
}
