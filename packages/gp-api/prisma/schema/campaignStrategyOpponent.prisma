model CampaignStrategyOpponent {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")

  campaignStrategy   CampaignStrategy @relation(fields: [campaignStrategyId], references: [id], onDelete: Cascade)
  campaignStrategyId Int              @map("campaign_strategy_id")

  fullName         String   @map("full_name")
  partyAffiliation String   @map("party_affiliation")
  incumbent        Boolean?

  // Candidate-supplied discovery hints, set only on the manual-entry path
  // (null for discovery-seeded opponents). Persisted so a later collect()
  // re-dispatch keeps the starting points the candidate provided.
  ballotpediaUrl String? @map("ballotpedia_url")
  websiteUrl     String? @map("website_url")

  @@index([campaignStrategyId])
  @@map("campaign_strategy_opponent")
}
