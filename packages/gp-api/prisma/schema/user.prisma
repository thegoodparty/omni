enum UserRole {
  admin
  sales
  candidate
  campaignManager
  demo
}

model User {
  id                    Int                     @id @default(autoincrement())
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  firstName             String?                 @default("") @map("first_name")
  lastName              String?                 @default("") @map("last_name")
  name                  String?
  avatar                String?
  password              String?
  hasPassword           Boolean                 @default(false) @map("has_password")
  email                 String                  @unique
  clerkId               String?                 @unique @map("clerk_id")
  phone                 String?
  zip                   String?
  roles                 UserRole[]              @default([])

  // SMS consent, captured by the rep on the HubSpot card when the lead agrees on
  // a call to be texted their magic link. Lives on the user rather than on the
  // link because consent outlives any single link, and because "did this person
  // agree to be texted" has to be answerable without joining through a link.
  // `smsConsentSource` records who claimed it (e.g. "hubspot_card:<repEmail>").
  smsConsentAt          DateTime?               @map("sms_consent_at")
  smsConsentSource      String?                 @map("sms_consent_source")
  // Set from Sinch's inbound STOP callback. Checked before every send, so an
  // opt-out is enforced by us and not only by the carrier.
  smsOptedOutAt         DateTime?               @map("sms_opted_out_at")

  /// [UserMetaData]
  metaData              Json?                   @map("meta_data") @db.JsonB
  campaignUpdateHistory CampaignUpdateHistory[]
  organizations         Organization[]
  campaigns             Campaign[] //TODO: Pretty sure this is supposed to be a 1-to-1 relation here
  passwordResetToken    String?                 @map("password_reset_token")
  aiChats               AiChat[]
  electedOffices        ElectedOffice[]
  magicLink             MagicLink?
  annotations           Annotation[]
  chatConversations     ChatConversation[]
  artifactFeedbacks     ArtifactFeedback[]
  userAgendaUploads     UserAgendaUpload[]

  @@index([firstName])
  @@index([lastName])
  @@map("user")
}
