enum CivicPanelBuildPlanStatus {
  active
  completed
  exhausted
}

enum CivicPanelBuildChannel {
  text
  phone_banking
  door_knocking
}

/// An office's plan to build its civic panel across texts, calls and doors,
/// in waves. One active plan per office, held by a partial unique index in
/// the migration (Prisma cannot declare one). Step status is never stored:
/// it is read off the sends, call lists and walks the steps point at.
model CivicPanelBuildPlan {
  id               String                    @id @default(uuid(7))
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  electedOfficeId  String                    @map("elected_office_id")
  electedOffice    ElectedOffice             @relation(fields: [electedOfficeId], references: [id], onDelete: Cascade)
  organizationSlug String                    @map("organization_slug")
  organization     Organization              @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)
  goalMembers      Int                       @map("goal_members")
  /// The official's own time each week; every wave is sized from it.
  hoursPerWeek     Int                       @map("hours_per_week")
  /// Replaced by hoursPerWeek; nothing reads or writes it. Kept nullable so
  /// code still on it keeps working while the change deploys; drop it next.
  hoursPerMonth    Int?                      @map("hours_per_month")
  status           CivicPanelBuildPlanStatus @default(active)
  completedAt      DateTime?                 @map("completed_at")
  steps            CivicPanelBuildStep[]

  @@index([electedOfficeId])
  @@index([organizationSlug])
  @@map("civic_panel_build_plan")
}

/// One piece of a wave: a text, a call list or a walkable area. The list it
/// drew (`voterFileFilterId`, a frozen sample) is set when the step is
/// prepared; the send, call list or turf made from that list, and the dates,
/// are written by the plan read from what it finds, never by the official.
model CivicPanelBuildStep {
  id                 String                 @id @default(uuid(7))
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")
  planId             String                 @map("plan_id")
  plan               CivicPanelBuildPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  wave               Int
  channel            CivicPanelBuildChannel
  /// Order within the wave and channel: a wave's second walkable area is 2.
  position           Int                    @default(1)
  /// Residents to text, residents to call, or households to knock.
  targetSize         Int                    @map("target_size")
  voterFileFilterId  Int?                   @unique @map("voter_file_filter_id")
  voterFileFilter    VoterFileFilter?       @relation(fields: [voterFileFilterId], references: [id], onDelete: SetNull)
  preparedAt         DateTime?              @map("prepared_at")
  outreachId         Int?                   @map("outreach_id")
  outreach           Outreach?              @relation(fields: [outreachId], references: [id], onDelete: SetNull)
  phoneBankingListId Int?                   @map("phone_banking_list_id")
  phoneBankingList   PhoneBankingList?      @relation(fields: [phoneBankingListId], references: [id], onDelete: SetNull)
  doorKnockingTurfId Int?                   @map("door_knocking_turf_id")
  doorKnockingTurf   DoorKnockingTurf?      @relation(fields: [doorKnockingTurfId], references: [id], onDelete: SetNull)
  startedAt          DateTime?              @map("started_at")
  completedAt        DateTime?              @map("completed_at")
  expectedRepliesBy  DateTime?              @map("expected_replies_by")
  /// The official chose not to do this step. Only read while nothing was
  /// started from it.
  skippedAt          DateTime?              @map("skipped_at")

  @@unique([planId, wave, channel, position])
  @@index([outreachId])
  @@index([phoneBankingListId])
  @@index([doorKnockingTurfId])
  @@map("civic_panel_build_step")
}
