model ChatConversation {
  id String @id @default(cuid())

  /// Null on a background agent run: no user starts it.
  ownerUserId Int?  @map("owner_user_id")
  owner       User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  scope            ChatScope @default(briefing_annotation)
  organizationSlug String?   @map("organization_slug")
  title            String?

  anchor    Json?     @map("anchor")

  /// Set on a background agent run's conversation (src/agents): the run it
  /// holds the completed steps of.
  experimentRunId String?        @unique @map("experiment_run_id")
  experimentRun   ExperimentRun? @relation(fields: [experimentRunId], references: [runId], onDelete: Cascade)

  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  messages        ChatMessage[]
  agentMessages   AgentMessage[]
  messageFeedback ChatMessageFeedback[]
  attachments     ChatAttachment[]

  annotation Annotation?

  @@index([ownerUserId, deletedAt])
  @@index([ownerUserId, organizationSlug, scope, deletedAt])
  @@map("chat_conversation")
}

enum ChatScope {
  briefing_annotation
  chief_of_staff
  campaign_assistant
  ordinance_flow
  priority_flow
  background_agent
}
