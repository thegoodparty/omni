model ChatConversation {
  id String @id @default(cuid())

  /// Null on a background agent run: no user starts a scheduled run, and
  /// organizationSlug is its owner.
  ownerUserId Int?  @map("owner_user_id")
  owner       User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  scope            ChatScope @default(briefing_annotation)
  organizationSlug String?   @map("organization_slug")
  title            String?

  anchor Json? @map("anchor")

  /// Agent POC (AI SDK engine): a background run is one conversation, its
  /// messages the completed steps.
  status            AgentRunStatus? @map("status")
  shapeHash         String?         @map("shape_hash")
  /// When the task that stamped shapeHash booted, so an older task can tell
  /// a run stamped by newer code and hand it back.
  shapeStampedAt    DateTime?       @map("shape_stamped_at")
  /// Set when a shape change superseded this run: the fresh run that
  /// replaced it.
  supersededByRunId String?         @map("superseded_by_run_id")
  agentName         String?         @map("agent_name")
  runInput          Json?           @map("run_input") @db.JsonB
  /// The validated artifact.
  runOutput         Json?           @map("run_output") @db.JsonB
  runError          String?         @map("run_error")
  judgeReplay       Json?           @map("judge_replay") @db.JsonB
  deletedAt         DateTime?       @map("deleted_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  messages        ChatMessage[]
  messageFeedback ChatMessageFeedback[]
  attachments     ChatAttachment[]

  annotation Annotation?

  @@index([ownerUserId, deletedAt])
  @@index([ownerUserId, organizationSlug, scope, deletedAt])
  @@map("chat_conversation")
}

enum ChatScope {
  briefing_annotation
  chief_of_staff
  campaign_assistant
  ordinance_flow
  priority_flow
  background_agent
}

enum AgentRunStatus {
  queued
  running
  completed
  failed
  superseded
}
