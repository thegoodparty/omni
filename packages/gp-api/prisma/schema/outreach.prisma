enum OutreachType {
  text
  // Legacy: draft/intent rows from the old CSV/eCanvasser flow (all pending).
  doorKnocking
  // Native: one envelope row per generated door_knocking_route
  // (see doorKnockingRouteId) so routes appear in the unified outreach list.
  nativeDoorKnocking
  phoneBanking
  // Native: one envelope row per generated phone_banking_list (see
  // phoneBankingListId) so lists appear in the unified outreach list.
  nativePhoneBanking
  socialMedia
  robocall
  p2p
}

enum OutreachStatus {
  pending
  approved
  denied
  paid
  in_progress
  completed
  pending_payment
  canceled
  // A robocall whose send chain could not deliver (a permanent CallHub
  // failure). The history list shows "Couldn't send"; the satellite
  // OutreachRobocall.settleState (send_failed) is what drives it.
  failed
}

model Outreach {
  id                                Int                                @id @default(autoincrement())
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  // Nullable so a Serve elected-office org (no campaign row) can persist an
  // outreach row scoped by organizationSlug alone. See organizationSlug below
  // for the resulting invariant.
  campaign                          Campaign?                          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId                        Int?
  outreachType                      OutreachType                       @map("outreach_type")
  projectId                         String?                            @map("project_id")
  name                              String?
  status                            OutreachStatus?                    @default(pending)
  error                             String?
  audienceRequest                   String?                            @map("audience_request")
  script                            String?                            @db.Text
  message                           String?
  date                              DateTime?
  // The user's local calendar day for the send ("YYYY-MM-DD"), captured
  // from the offset-annotated create payload. `date` is a UTC instant, so
  // deriving the day from it at finalize time shifts evening sends onto
  // the next day for US timezones — Peerly needs the local day.
  scheduledLocalDate                String?                            @map("scheduled_local_date")
  // The candidate's chosen wall-clock send time ("HH:mm"), applied in each
  // contact's LOCAL timezone at approve (Peerly window start). Null on rows
  // created before the field existed — approve falls back to 09:00.
  scheduledLocalTime                String?                            @map("scheduled_local_time")
  imageUrl                          String?                            @map("image_url")
  voterFileFilter                   VoterFileFilter?                   @relation(fields: [voterFileFilterId], references: [id])
  voterFileFilterId                 Int?                               @map("voter_file_filter_id")
  // nativeDoorKnocking envelopes only: the list row carries its destination
  // (the per-channel pointer idiom, like phoneListId/projectId).
  //
  // The TURF is the authoritative link and the one a CHECK enforces (see
  // migration door_knocking_envelope_on_turf). It used to be the route, back
  // when creating a turf always bought one in the same transaction. The route
  // is bought at first knock now, so a turf can exist without one — and an
  // envelope hung off the route would have had nowhere to live in the window
  // between creating a campaign and walking it, taking the whole campaign out
  // of outreach history with it.
  doorKnockingTurf                  DoorKnockingTurf?                  @relation(fields: [doorKnockingTurfId], references: [id], onDelete: Cascade)
  doorKnockingTurfId                Int?                               @unique @map("door_knocking_turf_id")
  // Still here, and still unique: once a route exists it is how the walk is
  // reached, and turf -> route stays 1:1. Null until the route is bought.
  doorKnockingRoute                 DoorKnockingRoute?                 @relation(fields: [doorKnockingRouteId], references: [id], onDelete: Cascade)
  doorKnockingRouteId               Int?                               @unique @map("door_knocking_route_id")
  // nativePhoneBanking envelopes only: same per-channel pointer idiom as
  // doorKnockingRouteId above.
  phoneBankingList                  PhoneBankingList?                  @relation(fields: [phoneBankingListId], references: [id], onDelete: Cascade)
  phoneBankingListId                Int?                               @unique @map("phone_banking_list_id")
  phoneListId                       Int?                               @map("phone_list_id")
  // P2P-specific fields
  identityId                        String?                            @map("identity_id")
  didState                          String?                            @map("did_state")
  didNpaSubset                      String[]                           @default([]) @map("did_npa_subset")
  title                             String?
  // Persisted at draft time so a payment-webhook finalize can rebuild the CAS
  // Slack message when the original request (and browser) is long gone.
  textCount                         Int?                               @map("text_count")
  billableTextCount                 Int?                               @map("billable_text_count")
  campaignPlanDueDate               String?                            @map("campaign_plan_due_date")
  // The paid checkout session that funded this outreach, written at
  // finalize. Cancel-before-send resolves its payment intent for the
  // automatic refund; free-texts redemptions never set it.
  stripeCheckoutSessionId           String?                            @map("stripe_checkout_session_id")
  // CAS approval gate (SMS console): a scheduled p2p send stays dormant at
  // the vendor until an admin approval requests canvassers. All nullable —
  // pre-console rows and non-SMS channels never carry them.
  approvedAt                        DateTime?                          @map("approved_at")
  approvedBy                        String?                            @map("approved_by")
  deniedAt                          DateTime?                          @map("denied_at")
  deniedBy                          String?                            @map("denied_by")
  deniedReason                      String?                            @map("denied_reason")
  canvassRequestedAt                DateTime?                          @map("canvass_requested_at")
  // CAS's own message correction (the common fix path — deny is the rare
  // exception). Stamped for the audit trail; the message sends under the
  // candidate's name.
  adminEditedAt                     DateTime?                          @map("admin_edited_at")
  adminEditedBy                     String?                            @map("admin_edited_by")
  // Cancel attribution for the console's Canceled tab: who ended the send
  // (the candidate from the webapp, or a named admin from the console).
  // Nullable — pre-attribution cancels carry only the status flip.
  canceledAt                        DateTime?                          @map("canceled_at")
  canceledBy                        String?                            @map("canceled_by")
  canceledByAdmin                   Boolean                            @default(false) @map("canceled_by_admin")
  // Nullable by design: legacy rows resolve their org via the campaignId join;
  // no backfill. Invariant (DB-enforced by a CHECK, see migration
  // add_outreach_org_scope): every row needs exactly one scoping path —
  // campaignId (Win, campaign-scoped) or organizationSlug (Serve, org-only,
  // campaignId null). Cascade (not SetNull) so an org delete can never leave
  // a Serve row both-null: a Win row's organizationSlug always mirrors its
  // campaign's org, and that campaign's own Cascade relation already removes
  // the row when the org goes, so this only ever fires for real on Serve rows.
  organizationSlug                  String?                            @map("organization_slug")
  organization                      Organization?                      @relation(fields: [organizationSlug], references: [slug], onDelete: Cascade)
  // Set when the owning organization archives the row from the history
  // drawer; cleared on restore. Never set at creation.
  archivedAt                        DateTime?                          @map("archived_at")
  // Groups multiple door-knocking turfs under one campaign — every turf
  // in the group points at the campaign's anchor Outreach (the first
  // turf drawn). NULL means "this outreach is its own campaign" (an
  // anchor for a solo turf, or any non-door-knocking outreach). SetNull
  // on delete so removing the anchor promotes each sibling to its own
  // campaign rather than cascading them away — legacy rows stay null.
  campaignOutreach                  Outreach?                          @relation("OutreachCampaign", fields: [campaignOutreachId], references: [id], onDelete: SetNull)
  campaignOutreachId                Int?                               @map("campaign_outreach_id")
  campaignSiblings                  Outreach[]                         @relation("OutreachCampaign")
  social                            OutreachSocial?
  robocall                          OutreachRobocall?
  textRecipients                    OutreachTextRecipient[]
  textMessages                      PollIndividualMessage[]
  voterActivities                   VoterOutreachActivity[]
  raceOpponentContrasts             RaceOpponentContrast[]
  contactInteractionTexts           ContactInteractionText[]
  contactInteractionRobocalls       ContactInteractionRobocall[]
  voterFileFilterActivityConditions VoterFileFilterActivityCondition[]
  assignments                       OutreachAssignment[]

  @@index([campaignId])
  @@index([organizationSlug])
  @@index([campaignOutreachId])
  @@map("outreach")
}
