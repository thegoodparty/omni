enum TcrComplianceStatus {
  submitted
  pending
  approved
  rejected
  error
}

enum OfficeLevel {
  federal
  state
  local
}

// Committee types that map to Peerly's committee_type field.
// See: https://api-docs.peerly.com/reference/submit-campaign-verify-request
enum CommitteeType {
  HOUSE        @map("house")
  SENATE       @map("senate")
  PRESIDENTIAL @map("presidential")
  CANDIDATE    @map("candidate")
}

model TcrCompliance {
  id             String               @id @default(cuid())
  ein            String
  postalAddress  String
  committeeName  String               @map("committee_name")
  websiteDomain  String               @map("website_domain")
  filingUrl      String               @map("filing_url")
  phone          String
  email          String
  officeLevel    OfficeLevel          @map("office_level")
  fecCommitteeId String?              @map("fec_committee_id")
  committeeType  CommitteeType        @default(CANDIDATE) @map("committee_type")
  status         TcrComplianceStatus? @default(submitted)
  tdlcNumber     String?              @map("tdlc_number")
  kickoffSentAt  DateTime?            @map("kickoff_sent_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  campaign       Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     Int                  @unique @map("campaign_id")

  // Structured filing address, set when the candidate entered their address
  // manually instead of picking a Google suggestion (Places never suggests
  // PO Boxes, which election filings commonly use). When line1 is set, the
  // Peerly submissions read these components instead of resolving
  // campaign.placeId, and postalAddress carries the composed string.
  filingAddressLine1 String? @map("filing_address_line1")
  filingAddressLine2 String? @map("filing_address_line2")
  filingCity         String? @map("filing_city")
  filingState        String? @map("filing_state")
  filingZip          String? @map("filing_zip")

  peerlyIdentityId              String?   @unique @map("peerly_identity_id")
  peerlyRegistrationLink        String?   @map("peerly_registration_link")
  peerlyIdentityProfileLink     String?   @map("peerly_identity_profile_link")
  peerly10DLCBrandSubmissionKey String?   @unique @map("peerly_10dlc_brand_submission_key")
  peerlyCvVerificationId        String?   @map("peerly_cv_verification_id")
  peerlySubmissionStartedAt     DateTime? @map("peerly_submission_started_at")

  // Set when a Peerly Campaign Verify submission fails with the unrecoverable
  // billing/account error ("No payment method available"). Retrying can't fix a
  // Peerly-side billing outage, so the agent/kickoff re-dispatch paths hold off
  // re-submitting while this is within the cooldown window — one alert, no storm.
  peerlyBillingBlockedAt DateTime? @map("peerly_billing_blocked_at")

  agenticRunId               String?   @unique @map("agentic_run_id")
  agenticDispatchAttemptedAt DateTime? @map("agentic_dispatch_attempted_at")

  // The channel + destination Peerly used to deliver the CampaignVerify PIN,
  // read from the enriched retrieve_cv payload once the PIN is sent. Persisted
  // for HubSpot (Campaign Success visibility + nudge). `pinSentDetectedAt`
  // doubles as the once-only fire guard for the "PIN Sent" Segment event: the
  // detection sweep claims it with `updateMany WHERE pinSentDetectedAt IS NULL`
  // so a re-run can't re-fire the event.
  pinDeliveryMethod      String?   @map("pin_delivery_method")
  pinDeliveryDestination String?   @map("pin_delivery_destination")
  pinSentDetectedAt      DateTime? @map("pin_sent_detected_at")

  // Marks a row created by the admin "treat as 10DLC approved (internal
  // testing)" checkbox: status is 'approved' with no Peerly identity, so UI
  // gates pass but real P2P sends stay blocked. Internal accounts only.
  internalTestingApprovedAt DateTime? @map("internal_testing_approved_at")

  // Raw string mirrors of the live Peerly CampaignVerify status (`retrieve_cv`)
  // and identity profile status (`getProfile`), stamped by the nightly poll
  // (ENG-10793). Not Prisma enums — vendor values must degrade gracefully, same
  // reasoning as pinDeliveryMethod. The `*ChangedAt` columns advance only when
  // the observed value differs from what's stored, so they measure "how long
  // in this state" for the stuck-registration checks (ENG-10792).
  peerlyCvStatus               String?   @map("peerly_cv_status")
  peerlyCvStatusChangedAt      DateTime? @map("peerly_cv_status_changed_at")
  peerlyProfileStatus          String?   @map("peerly_profile_status")
  peerlyProfileStatusChangedAt DateTime? @map("peerly_profile_status_changed_at")

  // Once-only claims for escalating a Peerly-side stall into the shared
  // vendor Slack Connect channel (ENG-10796): CV stuck IN_REVIEW >3 business
  // days (case 2) and profile stuck waiting_to_finalize >3 business days
  // (case 3b). Cleared when the nightly poll observes the record leaving
  // that state, so a later re-stall escalates again as a new incident.
  cvInReviewEscalatedAt      DateTime? @map("cv_in_review_escalated_at")
  finalizeStalledEscalatedAt DateTime? @map("finalize_stalled_escalated_at")

  @@map("tcr_compliance")
}
