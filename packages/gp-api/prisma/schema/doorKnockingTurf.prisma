model DoorKnockingTurf {
  id                Int               @id @default(autoincrement())
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  // Not unique: one filter (audience) can be split into many turfs.
  voterFileFilter   VoterFileFilter   @relation(fields: [voterFileFilterId], references: [id], onDelete: Cascade)
  voterFileFilterId Int               @map("voter_file_filter_id")
  // The turf names the walk; the filter names the audience.
  name              String
  color             String
  /// [GeoJsonPolygon]
  geoPoly           Json              @map("geo_poly")
  // Optional only because the FK lives on the child. Since 3.0 the route is
  // bought in the same transaction that inserts this row, so a turf with no
  // route cannot be created; the migration deleted the ones that predate it.
  route             DoorKnockingRoute?

  // No completedAt/archivedAt here: the lifecycle lives on the Outreach
  // envelope (status + archivedAt), which since 3.0 every turf has. It used
  // to live here because the envelope needed a Campaign and a Serve org
  // knocks without one, so the knock transaction skipped it — that forced a
  // mirror write on both rows and the two columns drifted apart whenever one
  // half was missed. Serve orgs now get an org-scoped envelope of their own
  // (campaignId null, the dual-scope idiom every channel uses), so there is
  // exactly one home for it again.

  // Soft delete. Deleting the row cascades turf -> route -> stops -> targets
  // AND the Outreach envelope, which throws away the frozen addresses, the
  // name snapshots kept for privacy deletion, and a Geoapify route that was
  // billed once and is documented as never re-bought. Every turf is billed
  // from birth now, so this is the only delete there is — the hard-delete
  // branch for an unbought drawing has nothing left to match. Knock history
  // survives regardless: it hangs off the organization, not this chain.
  deletedAt DateTime? @map("deleted_at")

  @@index([voterFileFilterId])
  @@map("door_knocking_turf")
}
