// Exactly PhoneBankingPurpose's nine values, and deliberately not a
// door-knocking-shaped vocabulary of its own.
//
// This channel used to carry a local six-value list, and
// doorKnockingPurposes.ts records why it stopped: recommended lists key every
// universe on the shared OUTREACH_PURPOSE_VALUES intent vocabulary, and SMS,
// robocall and phone banking were consolidated onto it precisely so a fourth
// translation table would not exist. The wizard already picks a shared slug —
// this stores what it already picks.
//
// The union of the two rails: OUTREACH_PURPOSE_VALUES (Win) plus
// SERVE_OUTREACH_PURPOSE_VALUES, overlapping on introduce_myself,
// event_invite and custom. Door knocking has ONE route for both surfaces, so
// unlike phone banking there is nowhere to split them.
//
// What IS door knocking's own is the wording, which lives in
// DOOR_KNOCKING_PURPOSE_LABELS and its Serve twin — a label is copy on a
// card, and this is a slug on a row.
enum DoorKnockingPurpose {
  introduce_myself
  persuade_voters
  event_invite
  early_voting
  election_day_turnout
  custom
  // Serve-only, matching PhoneBankingPurpose's own split.
  explain_decision
  community_input
  share_resource
}

model DoorKnockingTurf {
  id                Int               @id @default(autoincrement())
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  // Not unique: one filter (audience) can be split into many turfs.
  voterFileFilter   VoterFileFilter   @relation(fields: [voterFileFilterId], references: [id], onDelete: Cascade)
  voterFileFilterId Int               @map("voter_file_filter_id")
  // The turf names the walk; the filter names the audience.
  name              String
  color             String
  // The goal the candidate picked on the wizard's first step, which until now
  // decided nothing but a suggested list name and was thrown away on submit.
  // Persisted because the talking points are generated from it, and because a
  // regeneration surface added later would otherwise have no way to know what
  // the list was for.
  //
  // Nullable, and staying that way: every turf created before this shipped
  // predates the question. The generated points fall back to the static build
  // for exactly those lists, which is what makes this shippable without a
  // backfill.
  purpose           DoorKnockingPurpose?
  /// [GeoJsonPolygon]
  geoPoly           Json              @map("geo_poly")
  // Optional only because the FK lives on the child. Since 3.0 the route is
  // bought in the same transaction that inserts this row, so a turf with no
  // route cannot be created; the migration deleted the ones that predate it.
  route             DoorKnockingRoute?

  // No completedAt/archivedAt here: the lifecycle lives on the Outreach
  // envelope (status + archivedAt), which since 3.0 every turf has. It used
  // to live here because the envelope needed a Campaign and a Serve org
  // knocks without one, so the knock transaction skipped it — that forced a
  // mirror write on both rows and the two columns drifted apart whenever one
  // half was missed. Serve orgs now get an org-scoped envelope of their own
  // (campaignId null, the dual-scope idiom every channel uses), so there is
  // exactly one home for it again.

  // Soft delete. Deleting the row cascades turf -> route -> stops -> targets
  // AND the Outreach envelope, which throws away the frozen addresses, the
  // name snapshots kept for privacy deletion, and a Geoapify route that was
  // billed once and is documented as never re-bought. Every turf is billed
  // from birth now, so this is the only delete there is — the hard-delete
  // branch for an unbought drawing has nothing left to match. Knock history
  // survives regardless: it hangs off the organization, not this chain.
  deletedAt DateTime? @map("deleted_at")

  @@index([voterFileFilterId])
  @@map("door_knocking_turf")
}
