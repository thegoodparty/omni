// Email outreach channel. Design: TDD "2026-10-26 | Email outreach channel
// v1" (ClickUp page 2ky4jq2q-157273) and src/emailOutreach/AGENTS.md.

// The 1:1 satellite of an Outreach row with outreachType = email. The send
// time is Outreach.date.
model OutreachEmail {
  id                   Int                       @id @default(autoincrement())
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  outreachId           Int                       @unique @map("outreach_id")
  outreach             Outreach                  @relation(fields: [outreachId], references: [id], onDelete: Cascade)
  senderId             Int                       @map("sender_id")
  sender               OutreachEmailSender       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  listId               Int?                      @map("list_id")
  list                 OutreachEmailList?        @relation(fields: [listId], references: [id], onDelete: Restrict)
  goal                 String
  // Keys into EMAIL_LAYOUTS and EMAIL_THEMES in @goodparty_org/contracts.
  // Strings, not enums, so a new theme needs no migration. A shipped theme
  // key is never edited in place; a changed theme gets a new key.
  layout               String
  theme                String
  subject              String
  headline             String?
  body                 String
  imageUrl             String?                   @map("image_url")
  buttonLabel          String?                   @map("button_label")
  buttonUrl            String?                   @map("button_url")
  paidForBy            String?                   @map("paid_for_by")
  // Frozen at confirm; never raised afterward, so the estimate, the hold
  // and the send agree.
  recipientCap         Int?                      @map("recipient_cap")
  sesTemplateName      String?                   @map("ses_template_name")
  preparedAt           DateTime?                 @map("prepared_at")
  stoppingAt           DateTime?                 @map("stopping_at")
  sentCount            Int                       @default(0) @map("sent_count")
  bouncedCount         Int                       @default(0) @map("bounced_count")
  complainedCount      Int                       @default(0) @map("complained_count")
  unsubscribedCount    Int                       @default(0) @map("unsubscribed_count")
  pausedAt             DateTime?                 @map("paused_at")
  pauseReason          OutreachEmailPauseReason? @map("pause_reason")
  // Counts at the last staff resume; auto-pause measures only what was sent
  // after them, so a resume doesn't immediately re-pause.
  resumedAt            DateTime?                 @map("resumed_at")
  resumeSentBase       Int                       @default(0) @map("resume_sent_base")
  resumeBouncedBase    Int                       @default(0) @map("resume_bounced_base")
  resumeComplainedBase Int                       @default(0) @map("resume_complained_base")
  recipients           OutreachEmailRecipient[]
  replies              OutreachEmailReply[]

  @@map("outreach_email")
}

enum OutreachEmailPauseReason {
  bounce_rate
  complaint_rate
  ses_account
  daily_quota
  manual
}
