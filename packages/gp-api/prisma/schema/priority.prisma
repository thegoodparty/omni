model Priority {
  id              String        @id @default(cuid())
  electedOfficeId String        @map("elected_office_id")
  electedOffice   ElectedOffice @relation(fields: [electedOfficeId], references: [id], onDelete: Cascade)

  title       String
  description String @db.Text

  source                   PrioritySource
  sourceCampaignPositionId Int?            @map("source_campaign_position_id")
  sourceCommunityIssueId   String?         @unique @map("source_community_issue_id")
  sourceCommunityIssue     CommunityIssue? @relation(fields: [sourceCommunityIssueId], references: [id])

  archivedAt DateTime? @map("archived_at")

  // The agent's working status: the seven steps and what each settled.
  // Shape + parser live in @goodparty_org/contracts (PriorityStatus.schema.ts),
  // which is APPEND-ONLY so rows written by an older build keep parsing. Never
  // read this column without going through parsePriorityStatus().
  status      Json?
  // Derived from `status` by the one service that writes it, so the list page
  // can sort and filter without parsing JSON. Never set these independently.
  currentStep String? @map("current_step")
  nextAction  String? @map("next_action")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  outreaches        Outreach[]
  briefingItemLinks MeetingBriefingItemLink[]
  profileIssues     PersonProfileIssue[]

  @@index([electedOfficeId, archivedAt])
  @@map("priority")
}

enum PrioritySource {
  win_import
  user_stated
  community_issue
}
