model Priority {
  id              String        @id @default(cuid())
  electedOfficeId String        @map("elected_office_id")
  electedOffice   ElectedOffice @relation(fields: [electedOfficeId], references: [id], onDelete: Cascade)

  title       String
  description String @db.Text

  source                   PrioritySource
  sourceCampaignPositionId Int?           @map("source_campaign_position_id")
  sourceCommunityIssueId String?      @unique @map("source_community_issue_id")
  sourceCommunityIssue   CommunityIssue? @relation(fields: [sourceCommunityIssueId], references: [id])

  // How far along the official is on this priority. Nullable because every
  // existing row predates the question, and because a priority created any way
  // other than the onboarding step (a Win import, the agent's crud_priorities
  // tool) has never been asked — null means "not asked yet", which is what the
  // home keys its next step on.
  stage PriorityStage?

  targetDate DateTime? @map("target_date") @db.Date
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  briefingItemLinks MeetingBriefingItemLink[]
  profileIssues     PersonProfileIssue[]

  @@index([electedOfficeId, archivedAt])
  @@map("priority")
}

enum PrioritySource {
  win_import
  user_stated
  community_issue
}

// Where the official is in solving a priority, in order. Deliberately not
// OrdinanceStatus (which tracks a document's lifecycle, not a person's
// progress) and not PersonProfileIssueStatus (which its own schema defines as a
// publication decision for the public profile, not issue state).
enum PriorityStage {
  // "I've started on this a bit."
  exploring
  // "I've already engaged constituents to understand their problems."
  gathering_input
  // "I have a solution and just need help shaping it."
  shaping
  // "It's going up for a vote and ready to go."
  ready_for_vote
}
