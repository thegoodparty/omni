{
  "extends": "./tsconfig.json",
  "exclude": [
    "deploy",
    "node_modules",
    "test",
    "dist",
    "scripts",
    // Eval harnesses, not product code. The judge's runners patch a Nest
    // singleton and a live Databricks provider by assignment, and
    // assertTestProcess is the only thing standing between that and a real
    // request — it passes on NODE_ENV=test in ANY process. Nothing outside
    // src/chats/evals imports them, so leaving them out of the build costs
    // nothing — verified: the only importers of envOverride and runEval are
    // `*.eval.test.ts` files, which never ship.
    //
    // THIS GLOB AND .swcrc.build.json'S HAVE TO MATCH. They did not once, and
    // envOverride.js and runEval.js reached dist WITHOUT having been
    // type-checked by `nest build`. CI never missed it, because `npm run
    // types` runs against tsconfig.json, which excludes neither — but a build
    // whose emit and type-check disagree on scope is one edit away from
    // shipping something nothing checked.
    "src/chats/evals/**",
    // The eval suites, for the same reason: they are held by the judge runner
    // (packages/judge), never by the app, and they import that workspace
    // package. Nothing in src/ imports a *.eval.ts, so dropping them from the
    // build costs nothing. `npm run types` runs against tsconfig.json, which
    // keeps them in the type-check program — a suite that stops compiling is
    // still a red CI job.
    "**/*.eval.ts",
    "**/*spec.ts"
  ]
}
