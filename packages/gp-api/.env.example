NODE_ENV="production | development | local | qa"
LOG_LEVEL="debug" # Available levels: https://github.com/pinojs/pino/blob/main/docs/api.md#level-string
ENABLE_QUERY_LOGGING=false
# Set per-deploy in deploy/index.ts to 'preview' | 'dev' | 'prod'. The only
# reliable prod-vs-non-prod signal (NODE_ENV is pinned to 'production' in
# every Docker build) — see shared/util/appEnvironment.util.ts.
OTEL_SERVICE_ENVIRONMENT=dev
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_INSTANCE_ID=
GIT_SHA=
HOST=localhost
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gpdb?schema=public"
# Preview shares one 0.5-ACU Aurora instance across every PR stack; caps the
# pool so 25+ previews don't exhaust it. Set by Pulumi in deploy/index.ts.
IS_PREVIEW=false
WEBAPP_ROOT_URL=http://localhost:4000
# Explicit override for the user-facing app origin (magic-link, password
# reset/set links). Unset in every deployed env; see
# shared/util/appEnvironment.util.ts for the resolution order.
APP_ROOT_URL=
CORS_ORIGIN=http://localhost:4000
# Shared secret sent as `x-revalidate-secret` when gp-api asks the marketing
# site to bust a person profile's ISR cache (publish/unpublish/delete). Must
# match MARKETING_REVALIDATE_SECRET on gp-marketing. If unset, the cache-bust is
# skipped (the page's own revalidate window is the backstop).
MARKETING_REVALIDATE_SECRET=
MARKETING_REVALIDATE_URL=
# Public origin of this gp-api instance. Used to build the WebSocket URL
# returned by POST /v1/speech/transcribe/session. The browser validates that
# this host matches NEXT_PUBLIC_API_BASE, so it must point at *this* API
# (e.g. http://localhost:3000 locally, https://gp-api-dev.goodparty.org in dev,
# https://gp-api.goodparty.org in prod).
PUBLIC_API_URL=http://localhost:3000
ASSET_DOMAIN=asset.domain.com

ELECTION_API_URL=https://election-api-dev.goodparty.org

# Voter data (the CRM's people queries) — sp_people_db, holding a
# least-privilege grant on m_people_api__voter and m_people_api__district only.
# NOT interchangeable with the Serve or Campaign Manager credentials: grants are
# per service principal. Secrets live in AWS Secrets Manager (GP_API_<ENV>).
#
# The workspace hostname is a constant in peopleDbx.config.ts — one workspace,
# and a workspace identifier is not a secret. The warehouse stays configurable
# so dev and prod can run on separate compute, and so moving off a saturated
# warehouse is a secret update rather than a deploy. Bare id, not a path.
#
# Required to read voter data at all: unset, every contacts/door-knocking read
# fails rather than falling back to another store.
PEOPLE_DATABRICKS_WAREHOUSE_ID=
PEOPLE_DATABRICKS_CLIENT_ID=
PEOPLE_DATABRICKS_CLIENT_SECRET=
# Local development may use a personal access token instead of the service
# principal; OAuth wins when both are present.
PEOPLE_DATABRICKS_API_KEY=

AUTH_SECRET=super-secret-jwt-key

CONTENTFUL_SPACE_ID=some-space-id
CONTENTFUL_ACCESS_TOKEN=some-access-token
# Name of the "AI Chat Prompt" Contentful entry to use for the campaign chat
# assistant. Defaults to "General" (prod). Point non-prod environments at a
# separate published entry (e.g. "Dev") to iterate on the prompt without
# affecting prod. The target entry must be PUBLISHED to sync.
CONTENTFUL_CHAT_PROMPT_NAME=General

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=super-secret-id
AWS_SECRET_ACCESS_KEY=super-secret-key
SQS_QUEUE=Some_Queue.fifo
# Base URL for the gp-admin console. Used to build the per-send results
# upload link in fulfilment Slack messages. One deployment fronts dev and
# prod, so every non-local environment uses https://admin.goodparty.org.
GP_ADMIN_BASE_URL=http://localhost:3500

SQS_QUEUE_BASE_URL=https://sqs.us-west-2.amazonaws.com/333022194791
# Optional: set by Pulumi in deploy/index.ts for deployed environments
CAMPAIGN_PLAN_RESULTS_BUCKET=

# Unset in preview envs by design — see agentExperiments/CLAUDE.md.
AGENT_DISPATCH_QUEUE_NAME=
AGENT_RUN_INPUTS_BUCKET=
AGENTIC_KICKOFF_SWEEP_INTERVAL=

HUBSPOT_TOKEN=some-key
# Optional: the HubSpot marketing single-send asset id for the PIN Sent /
# PIN Resent notification (ENG-11034). Unset until Ops creates the asset in
# HubSpot and enables the transactional-email scope on the token above — the
# existing Segment-event -> HubSpot workflow email path covers the
# notification until then.
HUBSPOT_PIN_SENT_EMAIL_ID=
# Optional: single-send asset ids for the remaining 10DLC compliance
# notifications (ENG-11035). Same unset-is-a-no-op behavior as above.
HUBSPOT_FORM_SUBMITTED_EMAIL_ID=
HUBSPOT_PIN_SUBMITTED_EMAIL_ID=
HUBSPOT_COMPLIANCE_COMPLETED_EMAIL_ID=
HUBSPOT_COMPLIANCE_REJECTED_EMAIL_ID=

# Optional: the HubSpot marketing single-send asset id for the poll results
# ready notification (ENG-11035). Unset until Ops creates the asset — the
# existing Segment-event -> HubSpot workflow email path covers it until then.
HUBSPOT_POLL_RESULTS_EMAIL_ID=
# Optional: the HubSpot marketing single-send asset id for the meeting
# briefing ready notification (ENG-11035). Unset until Ops creates the asset
# and confirms the portal spot-check in HUBSPOT_INTEGRATION.md — the
# existing Segment-event -> HubSpot workflow email path covers it until then.
HUBSPOT_BRIEFING_READY_EMAIL_ID=

SCHEDULED_MESSAGING_INTERVAL_SECS=3600
MAILGUN_API_KEY="some-key-for-you"
MAILGUN_INTERCEPT_EMAIL="youremail@goodparty.org" # Optional: use to make all mailgun emails send to this address
TRACK_MAILGUN_EMAILS=false # Should be true only on prod.

AI_MODELS="claude-sonnet-4-6"
AI_FALLBACK_MODEL=
# Not read directly by our code; the `ai` SDK's provider registry checks this
# name automatically when resolving a together.ai-hosted model id out of
# AI_MODELS above.
TOGETHER_AI_KEY=
LLAMA_AI_ASSISTANT="something"

GOOGLE_API_KEY=key
GEMINI_API_KEY=key

STRIPE_SECRET_KEY=sk-test
STRIPE_WEBSOCKET_SECRET=whsec-test

L2_DATA_KEY=key
BALLOT_READY_KEY=key

# Secrets Manager id of the curated local-dev bundle that POST /v1/dev-env/
# bundle vends to a verified thegoodparty GitHub org member. Set on the dev
# deploy only; leave it empty locally unless you are working on the vending
# endpoint itself and have AWS credentials that can read the secret.
LOCAL_DEV_ENV_SECRET_ID=

SLACK_APP_ID="SAMPLE_APP_ID"
SLACK_BOT_DEV_CHANNEL_ID="SAMPLE_DEV_CHANNEL_ID"
SLACK_BOT_DEV_CHANNEL_TOKEN="SAMPLE_DEV_CHANNEL_TOKEN"
SLACK_USER_FEEDBACK_CHANNEL_ID="SAMPLE_USER_FEEDBACK_CHANNEL_ID"
SLACK_USER_FEEDBACK_CHANNEL_TOKEN="SAMPLE_USER_FEEDBACK_CHANNEL_TOKEN"
SLACK_BOT_AI_CHANNEL_ID="SAMPLE_AI_CHANNEL_ID"
SLACK_BOT_AI_CHANNEL_TOKEN="SAMPLE_AI_CHANNEL_TOKEN"
SLACK_BOT_POLITICS_CHANNEL_ID="SAMPLE_POLITICS_CHANNEL_ID"
SLACK_BOT_POLITICS_CHANNEL_TOKEN="SAMPLE_POLITICS_CHANNEL_TOKEN"
SLACK_BOT_FEEDBACK_CHANNEL_ID="SAMPLE_FEEDBACK_CHANNEL_ID"
SLACK_BOT_FEEDBACK_CHANNEL_TOKEN="SAMPLE_FEEDBACK_CHANNEL_TOKEN"
SLACK_BOT_10DLC_COMPLIANCE_CHANNEL_ID="SAMPLE_10DLC_COMPLIANCE_CHANNEL_ID"
SLACK_BOT_10DLC_COMPLIANCE_CHANNEL_TOKEN="SAMPLE_10DLC_COMPLIANCE_CHANNEL_TOKEN"
SLACK_BOT_DELETIONS_CHANNEL_ID="SAMPLE_DELETIONS_CHANNEL_ID"
SLACK_BOT_DELETIONS_CHANNEL_TOKEN="SAMPLE_DELETIONS_CHANNEL_TOKEN"
SLACK_BOT_TEVYN_API_CHANNEL_ID="SAMPLE_TEVYN_API_CHANNEL_ID"
SLACK_BOT_TEVYN_API_CHANNEL_TOKEN="SAMPLE_TEVYN_API_CHANNEL_TOKEN"
SLACK_CAS_CLICKUP_TASKS_CHANNEL_ID="SAMPLE_CAS_CLICKUP_TASKS_CHANNEL_ID"
SLACK_CAS_CLICKUP_TASKS_CHANNEL_TOKEN="SAMPLE_CAS_CLICKUP_TASKS_CHANNEL_TOKEN"
SLACK_SHARED_PEERLY_10DLC_CHANNEL_ID="SAMPLE_SHARED_PEERLY_10DLC_CHANNEL_ID"

SEGMENT_WRITE_KEY=key

WINNERS_ELECTION_YEAR='2024'

PEERLY_MD5_EMAIL=MD5(email@domain.io)
PEERLY_MD5_PASSWORD=MD5(password)
PEERLY_ACCOUNT_NUMBER=12345678
PEERLY_API_BASE_URL=https://app.peerly.com/api
PEERLY_HTTP_TIMEOUT=10000 # 10 seconds
EXPLICITLY_LOG_PEERLY_TOKEN=false # Set to true to log Peerly token in the logs (useful for debugging, but sensitive information)
# CallHub (robocall / voice broadcast). The generic api.callhub.io host is
# deprecated; accounts are pinned to a regional host (ours is api-na1).
CALLHUB_API_KEY=your-callhub-api-key
CALLHUB_API_BASE_URL=https://api-na1.callhub.io
CALLHUB_HTTP_TIMEOUT=30000
CV_SCAN_PROFILE_SPACING_MS=350
CV_SCAN_RETRIEVE_SPACING_MS=60000 # 1 retrieve_cv call per minute (Peerly rate limit)

VERCEL_TOKEN="token"
VERCEL_PROJECT_ID="project_id"
VERCEL_TEAM_ID="team_id"
ENABLE_DOMAIN_PURCHASE=false

FORWARDEMAIL_API_TOKEN=your_api_token_here
FORWARDEMAIL_BASE_URL=https://api.forwardemail.net/v1

AMPLITUDE_PROJECT_API_KEY=some_key

BRAINTRUST_API_KEY= # Optional: enables LLM observability tracing

SERVE_ANALYSIS_BUCKET_NAME=serve-analyze-data-ENV
# Issue capture synthesis (constituentFeedback/). `mock` groups an effort's
# memos in-process and needs neither S3 nor the AI service; unset means
# `pipeline`, the deployed polls synthesis pipeline.
FEEDBACK_SYNTHESIS_ENGINE=mock
# With the mock engine: `canned` splits memos round-robin into three fixed
# themes with no model call; unset or `llm` groups them with one call.
FEEDBACK_SYNTHESIS_MOCK_GROUPING=
# Issue capture's offline memos (constituentFeedback/ and speech/). `mock`
# takes the upload at a dev-only gp-api route and "transcribes" with a
# fixture sentence after 3 seconds, so no S3 or Transcribe; unset means `aws`.
SPEECH_TRANSCRIBE_FILE_MODE=mock
TEVYN_POLL_CSVS_BUCKET=tevyn-poll-csvs-develop # To remove when we migrate away from tevyn-api
# Where the shared text delivery layer writes a send's recipient CSV
# (outreach/services/outreachTextDelivery.service.ts). Intentionally UNSET:
# it falls back to TEVYN_POLL_CSVS_BUCKET above, which exists in every
# environment. The object is an idempotency record, not a deliverable, so the
# two products sharing one bucket is fine, and the poll bucket's S3
# notification filters on the `input/` prefix while these keys have none, so
# writing here cannot trigger the analysis pipeline. Set this (and add the
# bucket to the gp-api task role in deploy/index.ts) only if the two ever need
# splitting.
OUTREACH_TEXT_CSVS_BUCKET=
ZIP_TO_AREA_CODE_BUCKET=zip-to-area-code-mappings-develop
MEETING_PIPELINE_BUCKET=meeting-pipeline-dev
ANNOTATION_ATTACHMENTS_BUCKET=annotation-attachments-dev
CHAT_ATTACHMENTS_BUCKET=goodparty-chat-attachments-dev
# Recorded/uploaded robocall audio. Point local at the dev bucket to exercise
# the presign upload flow (needs AWS creds that can PUT to it).
ROBOCALL_AUDIO_BUCKET=robocall-audio-dev
# Live-test harness: when set, the robocall send chain dials ONLY this one
# normalized 10-digit number instead of the real audience. Unset = normal
# behavior — see robocallPhonebook.service.ts.
ROBOCALL_TEST_OVERRIDE_NUMBER=
# Campaign plan PDF shares. When unset, the share endpoints return 503.
# Both vars are Pulumi-managed per env in deployed environments.
# API_PUBLIC_ROOT_URL is not the same as PUBLIC_API_URL above, which lives
# in Secrets Manager and serves speech.
CAMPAIGN_PLAN_SHARES_BUCKET=campaign-plan-shares-dev
API_PUBLIC_ROOT_URL=http://localhost:3000

# Get this here: https://api.slack.com/apps/A0166K4G4E6/oauth
SLACK_APP_BOT_TOKEN=your-slack-bot-token

CLERK_PUBLISHABLE_KEY=pk_...
CLERK_SECRET_KEY=sk_...
CLERK_AUTHORIZED_PARTIES=http://localhost:4000
CLERK_API_TIMEOUT_MS=2000

GP_API_MACHINE_SECRET=ak_...
# HMAC secret verifying agent M2M tokens minted by gp-broker (issuer
# 'gp-broker', audience 'gp-api'). Required at boot outside tests —
# vendors/clerk/services/clerk-auth.service.ts.
AGENT_MCP_TOKEN_SECRET=ak_...

# Optional: skip heavy MTFCC seeding for local runs
SKIP_MTFCC_SEED=false

# Dedicated local-setup Clerk dev machine's secret (ENG-11191). Mints a
# per-run M2M token so `npm run setup` can seed a QA login at the end of
# bootstrap. Absent = that step skips with a note; nothing else needs it.
LOCAL_SETUP_CLERK_MACHINE_SECRET=

ANTHROPIC_API_KEY=your-anthropic-key

# Brave Web Search — powers the ordinance_flow brave_search tool (finding a
# server-rendered copy of a code chapter when Municode renders blank). Absent =
# tool silently unregistered. Key lives in AWS Secrets Manager (GP_API_<ENV>).
BRAVE_API_KEY=your-brave-search-key

# Shared Serve credential for the chat assistants' Databricks tool (default
# prefix in llm/tools/databricksConnection.ts's resolveDatabricksConnection).
# Absent vars = tool silently unregistered, caller still boots.
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_API_KEY=

# Win constituent data (Campaign Manager) — sp_win_agent, own warehouse.
# Secret lives in 1Password ("Win agent SP credential") / AWS Secrets
# Manager (GP_API_<ENV>). Absent vars = tool silently unregistered.
WIN_DATABRICKS_SERVER_HOSTNAME=dbc-3d8ca484-79f3.cloud.databricks.com
WIN_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/a6f5281417d1c869
WIN_DATABRICKS_CLIENT_ID=
WIN_DATABRICKS_CLIENT_SECRET=

# Geoapify Route Planner — optimizes native door-knocking routes. Validated
# lazily at call time, so an environment without it still boots and only the
# knock endpoint 502s. Costs a little over 10 credits per stop against a
# shared daily pool, priced in doorKnocking/utils/geoapifyCost.util.ts; see
# waypointQuota.util.ts for the per-organization budget. Not the
# same key as the webapp's NEXT_PUBLIC_GEOAPIFY_TILES_KEY, which is
# domain-restricted and only serves map tiles. Secret lives in AWS Secrets
# Manager (GP_API_<ENV>).
GEOAPIFY_API_KEY=your-geoapify-key

# Cron gates for the campaign-tracker, meetings, and ordinances automations.
CAMPAIGN_TRACKER_AUTOMATION_ENABLED=false
MEETINGS_AUTOMATION_ENABLED=false
ORDINANCES_AUTOMATION_ENABLED=false
ORDINANCE_RESOLVE_TIMEOUT_MS=

# Kill switch for the P2P phone-list build moving off the POST request onto
# the queue (Voter Outreach 2.0). Defaults off/unset: the synchronous build
# is unchanged until this is flipped.
P2P_PHONE_LIST_ASYNC_BUILD=false

MAX_STRING_LENGTH=

# Outreach send-pipeline tuning knobs; each has a code default and is safe
# to leave unset.
DETAIL_FAILED_RETRY_COOLDOWN_MS=
DETAIL_OUTSTANDING_RETRY_COOLDOWN_MS=
OWNER_CACHE_TTL_MS=
QUEUE_JOBS_CACHE_TTL_MS=
SESSIONS_FLUSH_INTERVAL_MS=
TEST_SEND_COOLDOWN_MS=
VENDOR_READ_TIMEOUT_MS=
