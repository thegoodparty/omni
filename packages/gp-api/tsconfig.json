{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules", "contracts", "dist", "scripts", "deploy"],
  "compilerOptions": {
    "module": "NodeNext",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@e2e-tests/*": ["e2e-tests/*"]
    },
    "preserveWatchOutput": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  }
}
