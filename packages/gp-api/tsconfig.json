{
  "extends": "../../tsconfig.base.json",
  "exclude": ["node_modules", "contracts", "dist", "scripts", "deploy"],
  "compilerOptions": {
    "module": "NodeNext",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      // The SDK ships dist/index.d.ts ("typings") but its "exports" map has
      // no "types" condition, so NodeNext can't find its declarations.
      "@geoapify/route-planner-sdk": [
        "../../node_modules/@geoapify/route-planner-sdk/dist/index.d.ts"
      ]
    },
    "preserveWatchOutput": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  }
}
