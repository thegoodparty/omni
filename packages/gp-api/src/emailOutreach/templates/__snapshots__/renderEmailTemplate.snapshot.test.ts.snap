// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderEmailTemplate, original presets > renders the long_update serve example unchanged 1`] = `
{
  "html": "<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light only"/><meta name="supported-color-schemes" content="light only"/><title>Your October update from Ward 2</title><style>:root{color-scheme:light only;supported-color-schemes:light only}@media (prefers-color-scheme:dark){.em-bg{background-color:#EFF5FF !important}.em-card{background-color:#FFFFFF !important}.em-header{background-color:#1E63EC !important}.em-rule{background-color:#1E63EC !important}.em-band{background-color:#1E63EC !important}.em-divider{background-color:#D6E7FF !important}.em-accent{background-color:#DC1438 !important}.em-cta{background-color:#1E63EC !important}.em-header-text{color:#FFFFFF !important}.em-headline{color:#0B1529 !important}.em-subheading{color:#1E63EC !important}.em-body{color:#1D305C !important}.em-meta{color:#1D305C !important}.em-cta-text{color:#FFFFFF !important}.em-cta-link{color:#1E63EC !important}.em-accent-text{color:#FFFFFF !important}}@media only screen and (max-width:620px){.em-pad{padding-left:20px !important;padding-right:20px !important}.em-page{padding-left:0 !important;padding-right:0 !important}}</style></head><body bgcolor="#EFF5FF" class="em-bg" style="background-color:#EFF5FF;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">Crosswalks, the library budget and a change to recycling day.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="margin:0;padding:0;background-color:#EFF5FF;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#EFF5FF" class="em-bg" style="background-color:#EFF5FF;width:100%"><tbody><tr><td align="left" bgcolor="#EFF5FF" class="em-bg em-page" style="background-color:#EFF5FF;padding:24px 12px;text-align:left"><table role="presentation" width="600" cellPadding="0" cellSpacing="0" border="0" bgcolor="#FFFFFF" class="em-card" style="width:100%;max-width:600px;background-color:#FFFFFF;margin:0 auto"><tbody><tr><td style="padding:0"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#1E63EC" class="em-header" style="background-color:#1E63EC;width:100%"><tbody><tr><td align="left" bgcolor="#1E63EC" class="em-header em-pad" style="background-color:#1E63EC;padding:28px 40px 24px;text-align:left"><h1 class="em-header-text" style="margin:0 0 8px;color:#FFFFFF;font-size:28px;line-height:35px;font-weight:800">Your October update from Ward 2</h1><p class="em-header-text" style="font-size:14px;line-height:20px;margin:0;color:#FFFFFF;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Renee Wells · November 3, 2026</p></td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#1E63EC" class="em-rule" style="background-color:#1E63EC;width:100%"><tbody><tr><td align="left" bgcolor="#1E63EC" class="em-rule" height="3" style="background-color:#1E63EC;padding:0;text-align:left;height:3px;line-height:3px;font-size:1px"> </td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#FFFFFF" class="em-card" style="background-color:#FFFFFF;width:100%"><tbody><tr><td align="left" bgcolor="#FFFFFF" class="em-card em-pad" style="background-color:#FFFFFF;padding:32px 40px 16px;text-align:left"><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>Hi {{first_name}},</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>A lot moved forward this month on the issues you’ve raised with me. Here’s where things stand, what I voted for and why, and what’s coming up next.</span></p><h2 class="em-subheading" style="margin:28px 0 12px;color:#1E63EC;font-size:21px;line-height:26px;font-weight:700;text-align:left">A safer crossing at Pine and 5th</h2><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>After more than 40 of you wrote in about near misses outside Lincoln Elementary, I asked the traffic engineer to study the intersection. The study found that most drivers were going well over the school-zone limit at drop-off time.</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>On October 14 the council approved a raised crosswalk and two new flashing signs. Construction starts next week and should finish before winter break.</span></p><h2 class="em-subheading" style="margin:28px 0 12px;color:#1E63EC;font-size:21px;line-height:26px;font-weight:700;text-align:left">The library keeps its Sunday hours</h2><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>The first draft of next year’s budget closed the main library on Sundays to save about $40,000. I voted against that line. Sunday is the only day many working parents can bring their kids, and the library is the only free place in the ward with reliable internet.</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>The final budget keeps the library open seven days a week. The savings will come from delaying a vehicle purchase instead.</span></p><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="width:100%;margin:12px 0 20px"><tbody><tr><td bgcolor="#D6E7FF" class="em-divider" height="1" style="background-color:#D6E7FF;height:1px;line-height:1px;font-size:1px"> </td></tr></tbody></table><h2 class="em-subheading" style="margin:28px 0 12px;color:#1E63EC;font-size:21px;line-height:26px;font-weight:700;text-align:left">Recycling moves to Thursdays</h2><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>Starting November 5, recycling pickup in Ward 2 moves from Monday to Thursday. Trash day doesn’t change. The city will leave a reminder tag on every bin the week before.</span></p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" style="margin:8px 0 16px"><tbody><tr><td align="center" bgcolor="#1E63EC" class="em-cta" style="background-color:#1E63EC;border-radius:6px"><a href="https://example.org/riverton/ward-2-survey" class="em-cta-text" style="color:#FFFFFF;text-decoration-line:none;display:inline-block;padding:12px 24px;font-size:15px;font-weight:700;line-height:22px;text-decoration:none" target="_blank">Tell me what to work on next</a></td></tr></tbody></table><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>Thank you,<br/></span><span>Dana Whitfield<br/></span><span>City Council Member, Ward 2</span></p></td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#D6E7FF" class="em-divider" style="background-color:#D6E7FF;width:100%"><tbody><tr><td align="left" bgcolor="#D6E7FF" class="em-divider" height="1" style="background-color:#D6E7FF;padding:0;text-align:left;height:1px;line-height:1px;font-size:1px"> </td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#FFFFFF" class="em-card" style="background-color:#FFFFFF;width:100%"><tbody><tr><td align="left" bgcolor="#FFFFFF" class="em-card em-pad" style="background-color:#FFFFFF;padding:24px 32px 32px;text-align:left"><p class="em-meta" style="font-size:13px;line-height:20px;margin:0 0 8px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Paid for by Wells for Mayor</p><p class="em-meta" style="font-size:13px;line-height:20px;margin:0 0 8px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">You’re getting this email because you asked to hear from Renee Wells.</p><p class="em-meta" style="font-size:13px;line-height:20px;margin:0 0 8px;color:#1D305C;text-align:left;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">916 Silver Spur Rd #310, Rolling Hills Estates, CA 90274</p><p class="em-meta" style="font-size:13px;line-height:20px;margin:0;color:#1D305C;text-align:left;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0"><a href="{{unsubscribe_url}}" ses:no-track="" class="em-meta" style="color:#1D305C;text-decoration-line:none;text-decoration:underline" target="_blank">Unsubscribe</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "subject": "Your October update from Ward 2",
  "text": "Your October update from Ward 2

Renee Wells · November 3, 2026

 

Hi {{first_name}},

A lot moved forward this month on the issues you’ve raised with me. Here’s where things stand, what I voted for and why, and what’s coming up next.


A safer crossing at Pine and 5th

After more than 40 of you wrote in about near misses outside Lincoln Elementary, I asked the traffic engineer to study the intersection. The study found that most drivers were going well over the school-zone limit at drop-off time.

On October 14 the council approved a raised crosswalk and two new flashing signs. Construction starts next week and should finish before winter break.


The library keeps its Sunday hours

The first draft of next year’s budget closed the main library on Sundays to save about $40,000. I voted against that line. Sunday is the only day many working parents can bring their kids, and the library is the only free place in the ward with reliable internet.

The final budget keeps the library open seven days a week. The savings will come from delaying a vehicle purchase instead.

 


Recycling moves to Thursdays

Starting November 5, recycling pickup in Ward 2 moves from Monday to Thursday. Trash day doesn’t change. The city will leave a reminder tag on every bin the week before.

Tell me what to work on next https://example.org/riverton/ward-2-survey

Thank you,
Dana Whitfield
City Council Member, Ward 2

 

Paid for by Wells for Mayor

You’re getting this email because you asked to hear from Renee Wells.

916 Silver Spur Rd #310, Rolling Hills Estates, CA 90274

Unsubscribe {{unsubscribe_url}}",
}
`;

exports[`renderEmailTemplate, original presets > renders the long_update win example unchanged 1`] = `
{
  "html": "<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd"><html dir="ltr" lang="en"><head><meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/><meta name="x-apple-disable-message-reformatting"/><meta name="color-scheme" content="light only"/><meta name="supported-color-schemes" content="light only"/><title>What 1,200 conversations taught me</title><style>:root{color-scheme:light only;supported-color-schemes:light only}@media (prefers-color-scheme:dark){.em-bg{background-color:#DDF2E8 !important}.em-card{background-color:#FFFFFF !important}.em-header{background-color:#16695C !important}.em-rule{background-color:#16695C !important}.em-band{background-color:#16695C !important}.em-divider{background-color:#B2E1CC !important}.em-accent{background-color:#FFE06C !important}.em-cta{background-color:#257F68 !important}.em-header-text{color:#FFFFFF !important}.em-headline{color:#043630 !important}.em-subheading{color:#16695C !important}.em-body{color:#115449 !important}.em-meta{color:#115449 !important}.em-cta-text{color:#FFFFFF !important}.em-cta-link{color:#257F68 !important}.em-accent-text{color:#043630 !important}}@media only screen and (max-width:620px){.em-pad{padding-left:20px !important;padding-right:20px !important}.em-page{padding-left:0 !important;padding-right:0 !important}}</style></head><body bgcolor="#DDF2E8" class="em-bg" style="background-color:#DDF2E8;margin:0;padding:0"><!--$--><!--html--><!--head--><div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0" data-skip-in-text="true">What I heard at the doors this month, and what I’ll do about it.<div> ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿ ‌​‍‎‏﻿</div></div><!--body--><table border="0" width="100%" cellPadding="0" cellSpacing="0" role="presentation" align="center"><tbody><tr><td style="margin:0;padding:0;background-color:#DDF2E8;font-family:-apple-system, BlinkMacSystemFont, &#x27;Segoe UI&#x27;, Roboto, Helvetica, Arial, sans-serif"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#DDF2E8" class="em-bg" style="background-color:#DDF2E8;width:100%"><tbody><tr><td align="left" bgcolor="#DDF2E8" class="em-bg em-page" style="background-color:#DDF2E8;padding:24px 12px;text-align:left"><table role="presentation" width="600" cellPadding="0" cellSpacing="0" border="0" bgcolor="#FFFFFF" class="em-card" style="width:100%;max-width:600px;background-color:#FFFFFF;margin:0 auto"><tbody><tr><td style="padding:0"><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#16695C" class="em-header" style="background-color:#16695C;width:100%"><tbody><tr><td align="left" bgcolor="#16695C" class="em-header em-pad" style="background-color:#16695C;padding:28px 40px 24px;text-align:left"><h1 class="em-header-text" style="margin:0 0 8px;color:#FFFFFF;font-size:28px;line-height:35px;font-weight:800">What I heard at your doors</h1><p class="em-header-text" style="font-size:14px;line-height:20px;margin:0;color:#FFFFFF;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0">Renee Wells · November 3, 2026</p></td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#16695C" class="em-rule" style="background-color:#16695C;width:100%"><tbody><tr><td align="left" bgcolor="#16695C" class="em-rule" height="3" style="background-color:#16695C;padding:0;text-align:left;height:3px;line-height:3px;font-size:1px"> </td></tr></tbody></table><img alt="A volunteer talking with a resident on a front porch" src="https://app.goodparty.org/images/email-samples/hills.jpg" style="display:block;outline:none;border:none;text-decoration:none;width:100%;max-width:600px;height:auto" width="600"/><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#FFFFFF" class="em-card" style="background-color:#FFFFFF;width:100%"><tbody><tr><td align="left" bgcolor="#FFFFFF" class="em-card em-pad" style="background-color:#FFFFFF;padding:32px 40px 16px;text-align:left"><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>Hi {{first_name}},</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>This month our volunteers and I knocked on 1,200 doors east of the river. I want to tell you what voters told us, because it changed what this campaign will focus on for the next four weeks.</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>I expected to hear about property taxes. Some people did bring them up. But the thing almost everyone mentioned first was their water bill. One retired teacher on Birch Street showed me three months of bills that had gone up by a third, with no letter from the utility explaining why.</span></p><h2 class="em-subheading" style="margin:28px 0 12px;color:#16695C;font-size:21px;line-height:26px;font-weight:700;text-align:left">Why water bills keep going up</h2><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>The city council approved two rate increases in the last eighteen months. Both passed on the consent agenda, without public discussion. The utility says the money pays for pipe repairs, but it hasn’t published which repairs, where, or what they cost.</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>I don’t think that’s good enough. If we’re paying more, we deserve to see where the money goes.</span></p><h2 class="em-subheading" style="margin:28px 0 12px;color:#16695C;font-size:21px;line-height:26px;font-weight:700;text-align:left">What I’ll do on the council</h2><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>First, I’ll ask for an independent audit of the last two rate increases and put the results online. Second, I’ll move every future rate change off the consent agenda so it gets a real public hearing. Third, I’ll push for a simple monthly report showing which pipes were fixed and what each repair cost.</span></p><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" style="width:100%;margin:12px 0 20px"><tbody><tr><td bgcolor="#B2E1CC" class="em-divider" height="1" style="background-color:#B2E1CC;height:1px;line-height:1px;font-size:1px"> </td></tr></tbody></table><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>Early voting starts October 26. If you have a question about any of this, just reply. I read every email myself.</span></p><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>The candidate forum is Tuesday, October 20, at 7pm at Central High.</span></p><table role="presentation" cellPadding="0" cellSpacing="0" border="0" style="margin:8px 0 16px"><tbody><tr><td align="center" bgcolor="#257F68" class="em-cta" style="background-color:#257F68;border-radius:6px"><a href="https://example.org/jordan-ellis/water-plan" class="em-cta-text" style="color:#FFFFFF;text-decoration-line:none;display:inline-block;padding:12px 24px;font-size:15px;font-weight:700;line-height:22px;text-decoration:none" target="_blank">Read my full water plan</a></td></tr></tbody></table><p class="em-body" style="font-size:17px;line-height:28px;margin:0 0 16px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:16px;margin-left:0"><span>Thank you,<br/></span><span>Jordan Ellis<br/></span><span>Candidate for City Council, Ward 3</span></p></td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#B2E1CC" class="em-divider" style="background-color:#B2E1CC;width:100%"><tbody><tr><td align="left" bgcolor="#B2E1CC" class="em-divider" height="1" style="background-color:#B2E1CC;padding:0;text-align:left;height:1px;line-height:1px;font-size:1px"> </td></tr></tbody></table><table role="presentation" width="100%" cellPadding="0" cellSpacing="0" border="0" bgcolor="#FFFFFF" class="em-card" style="background-color:#FFFFFF;width:100%"><tbody><tr><td align="left" bgcolor="#FFFFFF" class="em-card em-pad" style="background-color:#FFFFFF;padding:24px 32px 32px;text-align:left"><p class="em-meta" style="font-size:13px;line-height:20px;margin:0 0 8px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">Paid for by Wells for Mayor</p><p class="em-meta" style="font-size:13px;line-height:20px;margin:0 0 8px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">You’re getting this email because you asked to hear from Renee Wells.</p><p class="em-meta" style="font-size:13px;line-height:20px;margin:0 0 8px;color:#115449;text-align:left;margin-top:0;margin-right:0;margin-bottom:8px;margin-left:0">916 Silver Spur Rd #310, Rolling Hills Estates, CA 90274</p><p class="em-meta" style="font-size:13px;line-height:20px;margin:0;color:#115449;text-align:left;margin-top:0;margin-bottom:0;margin-left:0;margin-right:0"><a href="{{unsubscribe_url}}" ses:no-track="" class="em-meta" style="color:#115449;text-decoration-line:none;text-decoration:underline" target="_blank">Unsubscribe</a></p></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table></td></tr></tbody></table><!--/$--></body></html>",
  "subject": "What 1,200 conversations taught me",
  "text": "What I heard at your doors

Renee Wells · November 3, 2026

 

Hi {{first_name}},

This month our volunteers and I knocked on 1,200 doors east of the river. I want to tell you what voters told us, because it changed what this campaign will focus on for the next four weeks.

I expected to hear about property taxes. Some people did bring them up. But the thing almost everyone mentioned first was their water bill. One retired teacher on Birch Street showed me three months of bills that had gone up by a third, with no letter from the utility explaining why.


Why water bills keep going up

The city council approved two rate increases in the last eighteen months. Both passed on the consent agenda, without public discussion. The utility says the money pays for pipe repairs, but it hasn’t published which repairs, where, or what they cost.

I don’t think that’s good enough. If we’re paying more, we deserve to see where the money goes.


What I’ll do on the council

First, I’ll ask for an independent audit of the last two rate increases and put the results online. Second, I’ll move every future rate change off the consent agenda so it gets a real public hearing. Third, I’ll push for a simple monthly report showing which pipes were fixed and what each repair cost.

 

Early voting starts October 26. If you have a question about any of this, just reply. I read every email myself.

The candidate forum is Tuesday, October 20, at 7pm at Central High.

Read my full water plan https://example.org/jordan-ellis/water-plan

Thank you,
Jordan Ellis
Candidate for City Council, Ward 3

 

Paid for by Wells for Mayor

You’re getting this email because you asked to hear from Renee Wells.

916 Silver Spur Rd #310, Rolling Hills Estates, CA 90274

Unsubscribe {{unsubscribe_url}}",
}
`;

