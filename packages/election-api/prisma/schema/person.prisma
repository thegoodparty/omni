// A canonical person in the civics graph — the spine behind a public
// /people/<slug>-<id8> profile. `id` is the civics canonical
// `gp_candidate_id` (person grain), minted by the gp-data-platform entity
// resolution and written here by ETL (BallotReady-anchored or GoodParty-native
// for people BallotReady doesn't know about). The application never writes this
// table. Fields mirror int__ballotready_person; the gp-api PersonProfile overlay
// holds the user-editable/product-owned fields, composed at render time.
model Person {
  id           String   @id @map("id") @db.Uuid // = gp_candidate_id
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  brPersonId   Int?     @map("br_person_id") // BallotReady Person databaseId; null for GP-native persons
  // Human-readable base slug (`first-last`) minted by the gp-data-platform
  // person mart. NOT unique — common names collide heavily (e.g. ~82 `jane-doe`
  // rows). The public URL is /people/<slug>-<id8>, where <id8> is the first 8
  // hex of `id`; the app appends it so every profile resolves to exactly one
  // person without pushing collision-disambiguation into the data pipeline.
  // by-slug lookup parses <id8> and does an indexed range scan on the `id` PK
  // (see persons.service.getPersonBySlug), using this column only to
  // disambiguate the rare case where two ids share the same 8-hex prefix.
  slug         String

  // Name parts (BallotReady Person)
  firstName  String? @map("first_name")
  middleName String? @map("middle_name")
  lastName   String? @map("last_name")
  nickname   String?
  suffix     String?
  fullName   String? @map("full_name")

  // Narrative + media
  bioText     String? @map("bio_text") // default About Me; overlay bioOverride wins
  headshotUrl String? @map("headshot_url") // primary of BallotReady images[]

  // Public links (BallotReady urls[], typed by `type`)
  websiteUrl   String? @map("website_url")
  linkedinUrl  String? @map("linkedin_url")
  facebookUrl  String? @map("facebook_url")
  twitterUrl   String? @map("twitter_url")
  instagramUrl String? @map("instagram_url") // BR urls[] type='instagram'

  // Personal contact PII — omitted from default responses (see persons.service).
  email String?
  phone String?

  // Variable nested BallotReady arrays; write-once from ETL, not queried.
  degrees     Json? // [{ degree, major, school, gradYear }]
  experiences Json? // [{ title, organization, start, end, type }]

  state String?

  // Whether the person has taken the GoodParty pledge. A gp-api-native flag
  // rolled up from their candidacies by ETL (a person is pledged if pledged on
  // any candidacy). Read-only, not PII — flows through default responses.
  isPledged Boolean @default(false) @map("is_pledged")

  // gp-api User.id that originated this person (GP-native / self-registered
  // people BallotReady never knew about). The gp-api User.id is a numeric
  // autoincrement, stored here as text — NOT a UUID. Populated by the
  // gp-data-platform person mart from the ER linkage
  // (elected_officials.gp_api_user_id / candidacy→campaign); read-only for the
  // API, exactly like is_pledged. Lets gp-api pull its own User.person_id
  // without the data platform writing to gp-api. Filter-only: never returned in
  // any response and never selectable via ?columns= (see persons.schema /
  // persons.service). Nullable; null for BallotReady-anchored persons with no
  // gp-api user.
  gpApiUserId String? @map("gp_api_user_id")

  // Relations
  Candidacies   Candidacy[]
  OfficeHolders OfficeHolder[]

  // Non-unique: the base slug collides for common names. Kept for the by-slug
  // collision tiebreak and any name-based filtering; the unique key stays `id`.
  @@index([slug])
  @@index([gpApiUserId])
}
