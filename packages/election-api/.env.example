NODE_ENV=
LOG_LEVEL="debug" # Available levels: https://github.com/pinojs/pino/blob/main/docs/api.md#level-string
HOST=localhost
PORT=3000
# Set by GitHub Actions — not set by hand.
CI=

CORS_ORIGIN=http://localhost:4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electiondb"

# Clerk M2M authentication. election-api is the recipient/verifier: it verifies
# incoming `mt_*` tokens against its own machine secret. Callers (gp-api,
# gp-marketing) mint tokens with their own machine secrets and must be
# connected to the election-api machine in the Clerk dashboard.
CLERK_SECRET_KEY=sk_...
CLERK_PUBLISHABLE_KEY=pk_...
ELECTION_API_MACHINE_SECRET=ak_...

# Set per-deploy by deploy/index.ts to 'preview' | 'dev' | 'prod'.
OTEL_SERVICE_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_HEADERS=

# Overrides for src/prisma/prisma.service.ts's connection pool sizing.
PRISMA_CONNECTION_LIMIT=10
PRISMA_POOL_TIMEOUT=20

# src/zipToPosition/zipToPosition.service.ts's district/zip match threshold.
PCT_DISTRICTZIP_TO_ZIP_THRESHOLD=0.005
