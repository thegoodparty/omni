LOG_LEVEL="debug" # Available levels: https://github.com/pinojs/pino/blob/main/docs/api.md#level-string

CORS_ORIGIN=http://localhost:4000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electiondb" 

# Clerk M2M authentication. election-api is the recipient/verifier: it verifies
# incoming `mt_*` tokens against its own machine secret. Callers (gp-api,
# gp-marketing) mint tokens with their own machine secrets and must be
# connected to the election-api machine in the Clerk dashboard.
CLERK_SECRET_KEY=sk_...
CLERK_PUBLISHABLE_KEY=pk_...
ELECTION_API_MACHINE_SECRET=ak_...
# When "true", requests without a valid M2M token are rejected with 401
# (except @PublicAccess routes like /v1/health). Otherwise the guard runs in
# observe-only mode: it verifies + logs but allows the request through.
ELECTION_API_AUTH_ENFORCED=false

# When "true", campaign-strategy-context serves each race's own projected
# turnout and its prediction bounds from the race row, and stops returning the
# always-November figure. Otherwise it resolves turnout from the district-keyed
# Projected_Turnout table by running the race's date through a hardcoded rule.
ELECTION_API_RACE_TURNOUT_ENABLED=false
