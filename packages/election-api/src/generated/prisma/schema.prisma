enum ElectionResult {
  WON
  LOST
  RUNOFF

  @@map("election_result")
}

model Candidacy {
  id           String   @id @map("id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  brDatabaseId Int      @map("br_database_id")
  slug         String   @unique // slugify firstName-lastName-normalizedPositionName

  // Candidacy
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  email         String?
  websiteUrl    String?  @map("website_url")
  party         String? // Use index 0 of parties array
  isIncumbent   Boolean? @map("is_incumbent")
  gpCandidateId String?  @map("gp_candidate_id") // Canonical civics candidate ID

  // Race for state, and potentially longest geoid Place on Race?
  placeName String? @map("place_name")
  state     String?

  // Person
  image String? // Use index 0 of images array
  about String? // From bioText on Person - if not available, generateAbout()
  urls  String[]

  // Position (from Candidacy -> Position)
  electionFrequency      Int[]   @map("election_frequency") // Formerly called term
  salary                 String?
  normalizedPositionName String? @map("normalized_position_name")
  positionName           String? @map("position_name")
  positionDescription    String? @map("position_description")

  // Relations
  Stances  Stance[]
  Race     Race?    @relation(fields: [raceId], references: [id])
  raceId   String?  @map("race_id") @db.Uuid
  Person   Person?  @relation(fields: [personId], references: [id])
  personId String?  @map("person_id") @db.Uuid // = gpCandidateId, typed FK to Person

  @@index([personId])
  @@index([raceId])
}

model District {
  id             String   @id @map("id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  state          String
  L2DistrictType String   @map("l2_district_type")
  L2DistrictName String   @map("l2_district_name")

  // L2-derived voter aggregates. Refresh cadence differs from the
  // geographic identity columns above (District itself is L2-derived,
  // but these recompute every aggregation run).
  registeredVoters Int? @map("registered_voters")
  // Distinct cellphone numbers (votertelephones_cellphoneformatted)
  // appearing on L2 voters in this district. Collapse is on the
  // phone-number value itself, so two voters sharing a household
  // phone count as one — matches per-channel send/dial costs
  // downstream (SMS, robocall).
  uniqueCellphones Int? @map("unique_cellphones")
  // Same collapse semantics for the L2 landline column.
  uniqueLandlines  Int? @map("unique_landlines")

  // Relations
  ProjectedTurnouts ProjectedTurnout[]
  Positions         Position[]
  TopIssues         DistrictTopIssue[]
  VoterDensity      DistrictVoterDensity[]
  VoterDensityMeta  DistrictVoterDensityMeta[]

  @@unique([state, L2DistrictType, L2DistrictName])
  @@map("District")
}

model DistrictTopIssue {
  id        String   @id @map("id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  district   District @relation(fields: [districtId], references: [id])
  districtId String   @map("district_id") @db.Uuid

  // Haystaq issue score column name (e.g. hs_charter_schools_support)
  issue      String
  issueLabel String   @map("issue_label")
  // Average Haystaq score across voters in the district (0-100)
  score      Float
  // Jurisdictional flags from gp-data-platform DATA-1903: the level(s) of
  // government where this issue is actionable. Not mutually exclusive — an
  // issue can be actionable at multiple levels. Nullable while the
  // gp-data-platform phase-(c) Airflow sync work is in flight; values are
  // populated by the next sync_election_api run after that PR lands. May
  // tighten to non-nullable in a follow-up once data is verified.
  isLocal    Boolean? @map("is_local")
  isRegional Boolean? @map("is_regional")
  isState    Boolean? @map("is_state")
  isFederal  Boolean? @map("is_federal")
  // Rank of the issue within the district (1 = highest score)
  issueRank  Int      @map("issue_rank")

  @@unique([districtId, issue])
}

// Precomputed voter-density heat-map cells, one row per H3 cell per district
// per resolution. Populated by the data team (dbt on Databricks; the loader
// rules are in docs/data-model.md), NOT by the application — the API reads it
// read-only and serves it to public /people profiles.
//
// Privacy contract: every row is an aggregated, k-anonymized cell
// (voter_count >= min_cell_count) whose (lat, lng) is the DETERMINISTIC H3 cell
// centroid, never a voter location. No PII columns. There is no H3 math in
// Postgres — the centroid is precomputed upstream, so the read is a plain
// indexed lookup.
model DistrictVoterDensity {
  resolution Int
  h3Index    String   @map("h3_index") // h3_h3tostring(h3); opaque to the app
  lat        Float // H3 cell centroid latitude
  lng        Float // H3 cell centroid longitude
  voterCount Int      @map("voter_count") // count in cell; always >= min_cell_count
  state      String
  updatedAt  DateTime @map("updated_at")

  // A cell keyed on a district that does not exist fails the load loudly, rather
  // than inserting cleanly and leaving a map that silently never renders.
  District   District @relation(fields: [districtId], references: [id])
  districtId String   @map("district_id") @db.Uuid

  // Only ever queried by (districtId, resolution); the PK's leading columns
  // already serve that lookup, and the explicit index keeps it cheap as the
  // table grows to every district x resolution.
  @@id([districtId, resolution, h3Index])
  @@index([districtId, resolution])
  @@map("District_Voter_Density")
}

// Per-district-per-resolution coverage bookkeeping, keyed the same way as the
// cells. `coverage` is the only column the app reads, and it reads it to decide
// whether to render the map at all (low coverage -> hide). The rest are the
// data team's build provenance, kept here so a suppressed or sparse district can
// be explained without re-running the pipeline; `minCellCount` in particular
// records the K a build actually used, which is the only way to tell after the
// fact whether a district was cut at the agreed policy K.
model DistrictVoterDensityMeta {
  resolution      Int
  coverage        Float // rendered_voters / total_voters, in [0, 1]
  minCellCount    Int      @map("min_cell_count") // the K-anonymity threshold used
  totalVoters     Int      @map("total_voters")
  geocodedVoters  Int      @map("geocoded_voters")
  renderedVoters  Int      @map("rendered_voters")
  suppressedCells Int      @map("suppressed_cells")
  state           String
  updatedAt       DateTime @map("updated_at")

  District   District @relation(fields: [districtId], references: [id])
  districtId String   @map("district_id") @db.Uuid

  @@id([districtId, resolution])
  @@map("District_Voter_Density_Meta")
}

// Constituent-support figures for one elected office, read by gp-api to render
// the Serve dashboard support estimate. Keyed on gp-api's ElectedOffice.id.
// Empty until the data team's ETL populates it from the civics mart
// (interim source: projected_registered_supporters / icp_voter_count); the ETL
// owns how these are computed and may evolve it without a product change.
model ElectedOfficeSupport {
  electedOfficeId     String   @id @map("elected_office_id") @db.Uuid
  supportConstituents Int      @map("support_constituents")
  totalConstituents   Int      @map("total_constituents")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("Elected_Office_Support")
}

model Issue {
  id           String   @id @map("id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  brDatabaseId Int      @map("br_database_id")
  expandedText String   @map("expanded_text")
  key          String?
  name         String
  parent       Issue?   @relation("IssueHierarchy", fields: [parentId], references: [id])
  parentId     String?  @map("parent_id") @db.Uuid
  children     Issue[]  @relation("IssueHierarchy")
  Stance       Stance[]
}

// A term a Person holds (or held) in an office — the "elected official" spine
// for public profiles. Populated by ETL from int__civics_elected_official_* /
// BallotReady office_holders_v3; `personId` is reconciled into the canonical
// `gp_candidate_id` space so a Person can join to both Candidacies and
// OfficeHolders. The application never writes this table.
model OfficeHolder {
  id               String   @id @map("id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  brOfficeHolderId Int?     @map("br_office_holder_id")

  // Office identity
  positionName           String?  @map("position_name")
  normalizedPositionName String?  @map("normalized_position_name")
  officeTitle            String?  @map("office_title")
  partyNames             String[] @map("party_names")

  // Term (BallotReady). termDateSpecificity flags year-only vs full-date values.
  startAt             DateTime? @map("start_at") @db.Date
  endAt               DateTime? @map("end_at") @db.Date
  termDateSpecificity String?   @map("term_date_specificity")
  isCurrent           Boolean?  @map("is_current")
  isAppointed         Boolean?  @map("is_appointed")
  isVacant            Boolean?  @map("is_vacant")
  numberOfSeats       Int?      @map("number_of_seats")
  // Next election for this seat (derived by ETL from the office's Race election
  // date + term frequency). Powers "Next election" in the profile's About Office.
  nextElectionDate    DateTime? @map("next_election_date") @db.Date

  // Mailing address (BallotReady office_holder_mailing_*)
  mailingAddressLine1 String? @map("mailing_address_line_1")
  mailingAddressLine2 String? @map("mailing_address_line_2")
  mailingCity         String? @map("mailing_city")
  mailingState        String? @map("mailing_state")
  mailingZip          String? @map("mailing_zip")

  // Office contact + links
  officePhone  String? @map("office_phone")
  officeEmail  String? @map("office_email")
  websiteUrl   String? @map("website_url")
  linkedinUrl  String? @map("linkedin_url")
  facebookUrl  String? @map("facebook_url")
  twitterUrl   String? @map("twitter_url")
  instagramUrl String? @map("instagram_url") // BR office_holders_v3 urls[] type='instagram'

  // Geography / district
  subAreaName  String? @map("sub_area_name")
  subAreaValue String? @map("sub_area_value")
  state        String?
  geoId        String? @map("geo_id")
  mtfcc        String?

  // Relations
  // OfficeHolder is a dependent child of Person: person_id is required and a row
  // is meaningless without one, so it cascades when ETL deletes/re-mints a Person
  // (vs. Candidacy, which is independent + nullable, so it uses SET NULL).
  Person     Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  personId   String    @map("person_id") @db.Uuid
  Position   Position? @relation(fields: [positionId], references: [id])
  positionId String?   @map("position_id") @db.Uuid

  @@index([personId])
  @@index([positionId])
}

// A canonical person in the civics graph — the spine behind a public
// /people/<slug> profile. `id` is the civics canonical
// `gp_candidate_id` (person grain), minted by the gp-data-platform entity
// resolution and written here by ETL (BallotReady-anchored or GoodParty-native
// for people BallotReady doesn't know about). The application never writes this
// table. Fields mirror int__ballotready_person; the gp-api PersonProfile overlay
// holds the user-editable/product-owned fields, composed at render time.
model Person {
  id         String   @id @map("id") @db.Uuid // = gp_candidate_id
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  brPersonId Int?     @map("br_person_id") // BallotReady Person databaseId; null for GP-native persons
  // The whole public slug, `first-last-<id8>`, minted by the gp-data-platform
  // person mart with the suffix already applied — <id8> is the first 8 hex of
  // `id`, which is what disambiguates the heavily colliding name part (~82
  // `jane-doe` rows). The public URL is /people/<slug> verbatim. The name part
  // is optional: a name that slugifies to empty (non-Latin scripts strip to
  // nothing) leaves the id suffix as the entire slug. by-slug lookup parses
  // <id8> and does an indexed range scan on the `id` PK (see
  // persons.service.getPersonBySlug), comparing this column whole only to
  // disambiguate the rare case where two ids share the same 8-hex prefix.
  slug       String

  // Name parts (BallotReady Person)
  firstName  String? @map("first_name")
  middleName String? @map("middle_name")
  lastName   String? @map("last_name")
  nickname   String?
  suffix     String?
  fullName   String? @map("full_name")

  // Narrative + media
  bioText     String? @map("bio_text") // default About Me; overlay bioOverride wins
  headshotUrl String? @map("headshot_url") // primary of BallotReady images[]

  // Public links (BallotReady urls[], typed by `type`)
  websiteUrl   String? @map("website_url")
  linkedinUrl  String? @map("linkedin_url")
  facebookUrl  String? @map("facebook_url")
  twitterUrl   String? @map("twitter_url")
  instagramUrl String? @map("instagram_url") // BR urls[] type='instagram'

  // Personal contact PII — omitted from default responses (see persons.service).
  email String?
  phone String?

  // Variable nested BallotReady arrays; write-once from ETL, not queried.
  degrees     Json? // [{ degree, major, school, gradYear }]
  experiences Json? // [{ title, organization, start, end, type }]

  state String?

  // Whether the person has taken the GoodParty pledge. A gp-api-native flag
  // rolled up from their candidacies by ETL (a person is pledged if pledged on
  // any candidacy). Read-only, not PII — flows through default responses.
  isPledged Boolean @default(false) @map("is_pledged")

  // gp-api User.id that originated this person (GP-native / self-registered
  // people BallotReady never knew about). The gp-api User.id is a numeric
  // autoincrement, stored here as text — NOT a UUID. Populated by the
  // gp-data-platform person mart from the ER linkage
  // (elected_officials.gp_api_user_id / candidacy→campaign); read-only for the
  // API, exactly like is_pledged. Lets gp-api pull its own User.person_id
  // without the data platform writing to gp-api. Filter-only: never returned in
  // any response and never selectable via ?columns= (see persons.schema /
  // persons.service). Nullable; null for BallotReady-anchored persons with no
  // gp-api user.
  gpApiUserId String? @map("gp_api_user_id")

  // Relations
  Candidacies   Candidacy[]
  OfficeHolders OfficeHolder[]

  // Values are unique, but the constraint is enforced upstream by the person
  // mart's own test rather than by this database. Kept for the by-slug
  // collision tiebreak and any name-based filtering; the unique key stays `id`.
  @@index([slug])
  @@index([gpApiUserId])
}

// A retired canonical person and the person that absorbed it — the forwarding
// address for a purged duplicate. Written only by the gp-data-platform ETL,
// exactly like Person itself; the application never writes this table.
// See dbt/project/models/marts/civics/PERSON_ID_RETIREMENT_HANDOFF.md.
//
// This table exists because a purge is otherwise unrecoverable. The public URL
// is /people/<first-last>-<id8>, where <id8> is the first 8 hex of Person.id,
// and by-slug lookup resolves on that id prefix (persons.service.ts). Delete
// the row and the only unique part of the URL is gone: the page cannot be
// redirected, only 404'd, and every inbound link and indexed result dies with
// it. One row here turns that 404 back into a 308.
//
// Many-to-one by construction. A real person routinely has several duplicate
// records, so several retiredIds share one survivingId; that is the normal
// shape, not an edge case. The key is retiredId alone, which is what keeps a
// redirect unambiguous — one retired id, one successor. The reverse (a split:
// one retired id with several successors) is out of contract, because there
// would be no correct redirect target and guessing would tell search engines
// that two different people are the same person.
model PersonMerge {
  // The purged duplicate's gp_candidate_id. Deliberately carries no FK to
  // Person: the row it names is gone, which is the entire point of this record
  // existing.
  retiredId String @id @map("retired_id") @db.Uuid

  // The TERMINAL survivor, not the immediate one — the ETL path-compresses
  // chains (A->B then B->C rewrites A->C, along with B's whole fan-in) so
  // resolution here is a single indexed lookup and cycles are impossible.
  // No FK either, so a survivor that is itself later retired doesn't fail the
  // write. The API still walks defensively (see resolveSurvivingPersonId) —
  // an uncompressed chain should degrade to a slower hop, not to a 404.
  survivingId String @map("surviving_id") @db.Uuid

  // The purged person's Person.slug as last published, for the same
  // prefix-collision tiebreak the live path does: when two ids share an 8-hex
  // prefix, getPersonBySlug compares the whole slug to pick between them. After
  // the purge there is nowhere else to recover it from. Nullable — a backfilled
  // row may not have it, in which case it loses a collision rather than
  // winning one.
  retiredSlug String? @map("retired_slug")

  // When the merge was published upstream. Drives the consumer cursor on
  // GET /v1/person-merges?since=, so it must advance monotonically per row.
  retiredAt DateTime @map("retired_at")

  createdAt DateTime @default(now()) @map("created_at")

  // retiredAt: the ?since= feed scan. survivingId: the reverse lookup ("what
  // did this person absorb"), used by the admin collision queue and by the
  // ETL's own fan-in rewrite.
  @@index([retiredAt])
  @@index([survivingId])
}

model Place {
  id           String   @id @map("id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  brDatabaseId Int      @map("br_database_id")
  name         String   @map("name")
  slug         String   @unique @map("slug") // This is each component of the geoId slugified joined by forward slashes ex: state/county-name/city-name, where state is 2 chars
  geoId        String   @unique @map("geoid")
  mtfcc        String?  @map("mtfcc")
  state        String   @db.Char(2)

  // Fun Facts
  cityLargest           String? @map("city_largest")
  countyName            String? @map("county_name")
  population            Int?    @map("population")
  density               Float?  @map("density")
  incomeHouseholdMedian Int?    @map("income_household_median")
  unemploymentRate      Float?  @map("unemployment_rate")
  homeValue             Int?    @map("home_value")

  // Relations
  Races    Race[]
  // Recursive relationships
  children Place[] @relation("PlaceHierarchy")
  parent   Place?  @relation("PlaceHierarchy", fields: [parentId], references: [id])
  parentId String? @map("parent_id") @db.Uuid

  //@@index([state])
}

model Position {
  id           String @id @map("id") @db.Uuid
  brDatabaseId String @map("br_database_id")
  brPositionId String @unique @map("br_position_id") // Must be the source Ballotready position ID
  state        String
  name         String

  // Office-level ICP eligibility from int__icp_offices, written by the
  // m_election_api__position dbt mart (gp-data-platform#473). Null = the
  // office's voter_count is unknown upstream.
  isWinIcp   Boolean? @map("is_win_icp")
  isServeIcp Boolean? @map("is_serve_icp")

  // Office compensation (BallotReady api_position.salary; position-scoped). Powers
  // the profile "About Office" salary row, incl. for sitting EOs with no active
  // candidacy (Race.salary is only reachable via a Candidacy). Free-text: BR
  // values include ranges/notes, so this mirrors Candidacy.salary as text.
  salary String? @map("salary")

  // Relations
  district   District? @relation(fields: [districtId], references: [id])
  districtId String?   @map("district_id") @db.Uuid()

  level PositionLevel? @map("level")

  Races          Race[]
  ZipToPositions ZipToPosition[]
  OfficeHolders  OfficeHolder[]
}

enum ElectionCode {
  General
  LocalOrMunicipal
  ConsolidatedGeneral
  Primary
}

model ProjectedTurnout {
  id               String       @id @map("id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  electionYear     Int          @map("election_year")
  electionCode     ElectionCode @map("election_code")
  projectedTurnout Int          @map("projected_turnout")
  inferenceAt      DateTime     @map("inference_at")
  modelVersion     String       @map("model_version")

  // Relations
  district   District @relation(fields: [districtId], references: [id])
  districtId String   @map("district_id") @db.Uuid

  @@index([districtId, electionYear])
  @@map("Projected_Turnout")
}

enum PositionLevel {
  CITY
  COUNTY
  FEDERAL
  LOCAL
  REGIONAL
  STATE
  TOWNSHIP
}

model Race {
  id                      String        @id @map("id") @db.Uuid
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")
  brHashId                String?       @map("br_hash_id")
  brDatabaseId            Int?          @map("br_database_id")
  electionDate            DateTime      @map("election_date")
  slug                    String        @map("slug") // This is the slug of the place combined with normalizedPositionName slugified, ex: tx/hidalgo/mission/county-sheriff
  state                   String        @db.Char(2)
  // Position
  positionGeoid           String?       @map("position_geoid")
  positionLevel           PositionLevel @map("position_level")
  normalizedPositionName  String?       @map("normalized_position_name")
  positionNames           String[]      @map("position_names")
  positionDescription     String?       @map("position_description")
  filingOfficeAddress     String?       @map("filing_office_address")
  filingPhoneNumber       String?       @map("filing_phone_number")
  paperworkInstructions   String?       @map("paperwork_instructions")
  filingRequirements      String?       @map("filing_requirements")
  isRunoff                Boolean?      @map("is_runoff")
  isPrimary               Boolean?      @map("is_primary")
  partisanType            String?       @map("partisan_type")
  filingDateStart         DateTime?     @map("filing_date_start")
  filingDateEnd           DateTime?     @map("filing_date_end")
  employmentType          String?       @map("employment_type")
  eligibilityRequirements String?       @map("eligibility_requirements")
  salary                  String?       @map("salary")
  subAreaName             String?       @map("sub_area_name")
  subAreaValue            String?       @map("sub_area_value")
  // Race-level civics attributes (DATA-1922)
  numberOfSeats           Int?          @map("number_of_seats")
  winNumber               Int?          @map("win_number") // HubSpot-archive-sourced path-to-victory number (like officeLevel below). Only present for 2023-2025 archived races; BallotReady supplies no win number, so this is null for all current/upcoming races and services fall back to a computed estimate.
  isPartisan              Boolean?      @map("is_partisan")
  officeType              String?       @map("office_type")
  officialOfficeName      String?       @map("official_office_name")
  officeLevel             String?       @map("office_level") // Civics (HubSpot-sourced) office level — distinct from BR positionLevel above
  // PositionElection
  frequency               Int[]         @map("frequency")
  // Turnout projection for this race's own election day, written nightly by
  // the data-platform race mart. Nullable because the model's horizon covers
  // only the current year plus two. The columns themselves ship one PR
  // earlier, so this one only starts reading them.
  electionCode            ElectionCode? @map("election_code")
  projectedTurnout        Int?          @map("projected_turnout")
  projectedTurnoutLower   Int?          @map("projected_turnout_lower")
  projectedTurnoutUpper   Int?          @map("projected_turnout_upper")
  inferenceAt             DateTime?     @map("inference_at")

  // Relations
  Place       Place?      @relation(fields: [placeId], references: [id])
  placeId     String?     @map("place_id") @db.Uuid
  Position    Position?   @relation(fields: [positionId], references: [id])
  positionId  String?     @map("position_id") @db.Uuid
  Candidacies Candidacy[]

  @@index([slug])
  @@index([positionId])
  @@index([brHashId])
  @@index([placeId])
}

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl"]
  previewFeatures = ["prismaSchemaFolder"]
  output          = "../../src/generated/prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Stance {
  id                 String   @id @map("id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  brDatabaseId       Int      @map("br_database_id")
  stanceLocale       String   @map("stance_locale")
  stanceReferenceUrl String   @map("stance_reference_url")
  stanceStatement    String   @map("stance_statement")

  // Relations
  Issue       Issue      @relation(fields: [issueId], references: [id])
  issueId     String     @map("issue_id") @db.Uuid
  Candidacy   Candidacy? @relation(fields: [candidacyId], references: [id])
  candidacyId String?    @map("candidacy_id") @db.Uuid

  @@index([candidacyId])
  @@index([issueId])
}

model ZipToPosition {
  id        String   @id @map("id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  position   Position @relation(fields: [positionId], references: [id])
  positionId String   @map("position_id") @db.Uuid

  // Denormalized from the dbt mart so callers can query without joining Position.
  // brDatabaseId is Int to match the dbt mart (bigint) and the rest of this
  // codebase (Place, Race, Candidacy, Issue, Stance). Position.brDatabaseId is
  // a String outlier we deliberately don't propagate.
  name         String
  brDatabaseId Int    @map("br_database_id")

  // Nullable; positions without zip coverage have null zip_code
  zipCode String? @map("zip_code")

  electionYear Int      @map("election_year")
  electionDate DateTime @map("election_date") @db.Date

  // Constrained by accepted_values in the upstream dbt model
  // (City, County, Federal, Judicial, Local, Regional, State, Township)
  displayOfficeLevel String @map("display_office_level")
  officeType         String @map("office_type")
  state              String @db.Char(2)
  district           String

  votersInZip         BigInt? @map("voters_in_zip")
  votersInZipDistrict BigInt? @map("voters_in_zip_district")
  pctDistrictzipToZip Float?  @map("pct_districtzip_to_zip")

  @@unique([zipCode, positionId, electionDate])
  @@index([zipCode])
  @@index([positionId])
  @@index([zipCode, pctDistrictzipToZip])
}
