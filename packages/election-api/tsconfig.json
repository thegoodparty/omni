{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "node20",
    "moduleResolution": "node16",
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": ".",
    "paths": {
      "*": ["./*"]
    },
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "exclude": ["deploy", "dist"]
}
