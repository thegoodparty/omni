{
  "name": "@goodparty_org/sdk",
  "version": "2.4.0",
  "description": "TypeScript SDK for interacting with the GoodParty API",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "npm run build:contracts && tsup",
    "build:contracts": "npx tsx ../contracts/scripts/ensure-built.cli.ts",
    "lint": "eslint \"src/**/*.ts\" --quiet",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint-format": "npm run lint:fix && npm run format",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "npm run build:contracts && tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thegoodparty/gp-sdk"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "globals": "^15.15.0",
    "prettier": "^3.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clerk/backend": "^2.30.1",
    "@goodparty_org/contracts": "*",
    "ofetch": "^1.5.1"
  }
}
