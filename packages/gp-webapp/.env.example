# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding/office-selection

# API
NEXT_PUBLIC_API_BASE=https://gp-api-dev.goodparty.org

# Analytics
NEXT_PUBLIC_SEGMENT_WRITE_KEY=
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GEOAPIFY_TILES_KEY=

# Admin Portal URL (for stop-impersonation redirect)
NEXT_PUBLIC_GP_ADMIN_URL=http://localhost:3500

# Optional / Deployment
NEXT_PUBLIC_VERCEL_TARGET_ENV=
NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL=
NEXT_PUBLIC_VERCEL_BRANCH_URL=
VERCEL_ENV=
NEXT_RUNTIME=
CI=
NODE_ENV=
# Legacy fallback read by the deprecated gpApi/gpFetch.ts helper; see
# APP_SHARE_BASE in appEnv.ts for why new code should not reintroduce it.
NEXT_PUBLIC_APP_BASE=https://goodparty.org
NEXT_PUBLIC_CANDIDATES_SITE_BASE=https://candidates.goodparty.org
NEXT_PUBLIC_MARKETING_SITE_DOMAIN=
NEXT_PUBLIC_P2P_CUTOFF_DATETIME=
NEXT_PUBLIC_DICTATION_DEMO_ENABLED=

# Build-time only: Sentry source-map upload during `next build`.
SENTRY_AUTH_TOKEN=

# Grafana Frontend Observability (Faro). Unset leaves Faro off; set it to the
# dev app's collector URL to report from a local run.
NEXT_PUBLIC_FARO_COLLECTOR_URL=
# Server-side request errors to Grafana Cloud OTLP, as the full Authorization
# header value. Unset reports nothing.
GRAFANA_OTLP_AUTHORIZATION=
# Build-time only: Faro source-map upload after `next build`. Skipped while
# any is unset.
FARO_SOURCEMAP_API_KEY=
FARO_SOURCEMAP_ENDPOINT=
FARO_SOURCEMAP_APP_ID=
# Set by GitHub Actions; next.config.ts derives NEXT_PUBLIC_GIT_SHA from it.
# Leave both empty locally.
GITHUB_SHA=
NEXT_PUBLIC_GIT_SHA=

# Shared secret gating POST /api/revalidate (machine-triggered cache-bust).
# Fails closed when unset — the endpoint is unusable, not open.
REVALIDATE_SECRET=

# Dev-only local briefing/issue galleries (app/dev/*); both hard-404 when
# NODE_ENV !== development. Overrides the default .local-briefings/ /
# .local-issues/ directories.
LOCAL_BRIEFINGS_DIR=
LOCAL_ISSUES_DIR=

# Load the HubSpot support chat locally. Production, dev and PR previews get it
# automatically from VERCEL_ENV, so this is only for local work.
# One portal, no sandbox: anything you send reaches the real support inbox.
NEXT_PUBLIC_SUPPORT_CHAT=
