.env
node_modules/
__pycache__/
.venv/

# Local agent run outputs (params, conversation transcripts, downloads, logs).
# These can contain absolute paths, candidate PII, and full LLM transcripts.
outputs/
.DS_Store

# Comparison stash for runbook→experiment translation iterations
# (see .claude/skills/build-cap-agent/SKILL.md and experiments/CLAUDE.md).
experiments/.collin_reference/

# Generated by scripts/python/publish_experiments.py — never commit.
# The publisher writes a fresh index.json to S3 on every publish; the
# committed file would silently strip hand-edited fields and mislead readers.
experiments/index.json

# Transient full-result report from scripts/python/analytics_event_health.py (--json).
# The committed durable artifacts are the longitudinal log + the diff state, not this.
scripts/python/analytics_event_health_report.json

# Event-health remediation payloads are transient dev-review artifacts (proposals fed to
# the event-metadata skill), not durable state. See books/monitor-event-health.md.
scripts/python/instrumentation_data/event-metadata-payload-*.yaml

# Cached OAuth token for the event-state Google Sheets sink (event_state_gsheet.py).
# It is a credential — never commit it. As of DATA-2061 the token defaults to a location
# outside the checkout (GP_SHEETS_TOKEN_PATH / ~/.config/gp-event-state); this legacy
# in-checkout path is still honored and kept ignored for back-compat.
scripts/python/instrumentation_data/gsheet_token.pickle
