# Secrets and credentials for script execution
# AI agents MUST NOT read this file
# Only used at runtime by scripts

# API_KEY=
# DATABASE_URL=

# CIRCLE_API_KEY= example from https://app.circle.so/admin/developer-tokens (Admin API v2 Bearer token)

# CLICKUP_API_KEY= example pk_xxx (ClickUp → Settings → Apps → API Token; sent as raw value, no Bearer prefix)

# Databricks SQL warehouse — used by databricks_query.py (PAT) and the provenance backfill.
# DATABRICKS_SERVER_HOSTNAME= example dbc-xxxx.cloud.databricks.com
# DATABRICKS_HTTP_PATH= example /sql/1.0/warehouses/xxxx
# DATABRICKS_API_KEY= personal access token (PAT path only)

# databricks_oauth.py (the event-health monitor) authenticates via the Databricks SDK
# profile in ~/.databrickscfg (`databricks auth login`) — no PAT. It still needs
# DATABRICKS_HTTP_PATH above; pick the profile with DATABRICKS_CONFIG_PROFILE if not default.
# DATABRICKS_CONFIG_PROFILE= example tristana_goodparty

# event_state_slack.py (DATA-2057) — push analytics event-lifecycle updates to Slack.
# Shared BOT token (chat.postMessage, chat:write scope), never a personal OAuth token.
# Use a DEDICATED Slack app with token rotation OFF, so the xoxb- token is stable and
# non-expiring — a rotating token is short-lived (~12h) and unusable for a run-on-demand
# script. (The env var keeps gp-api's canonical SLACK_APP_BOT_TOKEN name, but this is its
# own app, not gp-api's.) Only the Bot User OAuth Token is needed — no OAuth flow, no
# client id/secret, no redirect URL. Store the value in 1Password per the secret convention.
# SLACK_APP_BOT_TOKEN= example xoxb-... (dedicated app's bot token, chat:write, no rotation)
# SLACK_EVENT_LIFECYCLE_CHANNEL_ID= example C0BECEK0603 (the dedicated channel id)
#
# Agent bootstrap (no manual paste): the token lives in the shared 1Password item
# "Slack analytics-event-bot OAuth" (vault Product-Analytics). On any machine with `op`
# signed in and access to that vault, populate scripts/.env without ever printing the
# token — run from scripts/ (idempotent; won't clobber existing keys):
#   tok=$(op read 'op://Product-Analytics/Slack analytics-event-bot OAuth/notesPlain' 2>/dev/null)
#   [[ "$tok" == xoxb-* ]] && ! grep -q '^SLACK_APP_BOT_TOKEN=' .env && printf 'SLACK_APP_BOT_TOKEN=%s\n' "$tok" >> .env
#   grep -q '^SLACK_EVENT_LIFECYCLE_CHANNEL_ID=' .env || printf 'SLACK_EVENT_LIFECYCLE_CHANNEL_ID=%s\n' 'C0BECEK0603' >> .env
# If op is unavailable or the vault is not shared with you, paste the value in manually.
# Optional, non-secret: overrides the "Event-state sheet" link in posts. If unset, the link
# is derived from GP_EVENT_STATE_SHEET_ID (already set for the DATA-2052 gSheet sink), so
# you normally do not need this.
# GP_EVENT_STATE_SHEET_URL= example https://docs.google.com/spreadsheets/d/<id>/edit

# Geoapify (door-knocking map POC: basemap tiles + route optimization).
# Free tier is plenty: https://www.geoapify.com/
# GEOAPIFY_API_KEY= example 0123abcd...
