{
  "$schema": "../_schema/manifest.schema.json",
  "id": "top_community_issues",
  "version": 3,
  "model": "opus",
  "max_turns": 150,
  "timeout_seconds": 3000,
  "scope": {
    "allowed_tables": [
      "goodparty_data_catalog.dbt.int__l2_nationwide_uniform_w_haystaq"
    ],
    "max_rows": 50000,
    "data_required_unless": {
      "field": "data_quality",
      "values": ["insufficient_signal"]
    }
  },
  "input_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": ["organization_slug", "state", "office", "district_descriptor"],
    "properties": {
      "organization_slug": {
        "type": "string",
        "minLength": 1,
        "description": "GoodParty organization slug for the elected official."
      },
      "state": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "2-letter state code (e.g. NY)."
      },
      "office": {
        "type": "string",
        "minLength": 1,
        "description": "Name of the elected official's office (e.g. 'City Council Member')."
      },
      "district_descriptor": {
        "type": "string",
        "minLength": 1,
        "description": "Human-readable district description (e.g. 'District 5, Chicago, IL')."
      }
    }
  },
  "output_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "TopCommunityIssuesOutput",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "list",
      "organization_slug",
      "generated_for_run_id",
      "issues",
      "claims",
      "sources",
      "data_quality"
    ],
    "properties": {
      "schema_version": {
        "type": "integer",
        "const": 1
      },
      "list": {
        "type": "string",
        "const": "top_community"
      },
      "organization_slug": {
        "type": "string",
        "minLength": 1
      },
      "generated_for_run_id": {
        "type": "string",
        "minLength": 1
      },
      "issues": {
        "type": "array",
        "maxItems": 10,
        "items": {
          "$ref": "#/definitions/IssueOutput"
        }
      },
      "claims": {
        "type": "array",
        "description": "QA projection: each issue's discrete factual assertions decomposed into individually-adjudicable claims. Read by the QA spine (qa_validate.py). Each claim links back to its issue via item_id.",
        "items": {
          "$ref": "#/definitions/Claim"
        }
      },
      "sources": {
        "type": "array",
        "description": "QA projection: the deduped union of every issue's detail.sources[]. The QA spine reads provenance from this top-level array (claims[].source_ids resolve here).",
        "items": {
          "$ref": "#/definitions/Source"
        }
      },
      "sources_used": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "data_quality": {
        "type": "string",
        "enum": ["ok", "partial", "insufficient_signal"]
      },
      "data_quality_reason": {
        "type": "string"
      },
      "notes": {
        "type": "string"
      }
    },
    "definitions": {
      "IssueOutput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "category",
          "priority",
          "rank",
          "detail"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "Stable id for this issue within the artifact, referenced by claims[].item_id. Distinct from existing_issue_id, which links to a record in the live community-issue feed. Use a slug or issue-<rank> style id."
          },
          "existing_issue_id": {
            "type": "string",
            "minLength": 1,
            "description": "ID of the existing community issue in the feed, if this issue already exists."
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "enum": [
              "infrastructure_and_transportation",
              "public_safety",
              "education",
              "housing_and_development",
              "health_and_human_services",
              "economic_development",
              "quality_of_life",
              "government_operations",
              "other"
            ]
          },
          "priority": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "detail": {
            "$ref": "#/definitions/IssueDetail"
          }
        }
      },
      "IssueDetail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sources", "overview"],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/Source"
            }
          },
          "overview": {
            "$ref": "#/definitions/Subsection"
          },
          "history": {
            "$ref": "#/definitions/Subsection"
          },
          "quotes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["items"],
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/QuoteItem"
                }
              }
            }
          },
          "research": {
            "$ref": "#/definitions/Subsection"
          },
          "legislation": {
            "$ref": "#/definitions/Subsection"
          }
        }
      },
      "Subsection": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "source_ids"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "QuoteItem": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "source_id"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "attribution": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "Claim": {
        "type": "object",
        "additionalProperties": false,
        "description": "One discrete, independently-verifiable factual assertion drawn from an issue. This is the unit the QA spine adjudicates (supported / unsupported / contradicted).",
        "required": [
          "claim_id",
          "item_id",
          "claim_text",
          "claim_type",
          "claim_weight",
          "source_ids",
          "source_extracts"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "description": "Unique id for this claim within the artifact."
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "description": "id of the issue in issues[] that this claim supports."
          },
          "claim_text": {
            "type": "string",
            "minLength": 1,
            "description": "The single factual assertion, self-contained and checkable (name the dollar, date, vote, project, or location)."
          },
          "claim_type": {
            "type": "string",
            "description": "Kind of assertion. The high-weight/blockable types (figure, date, vote, existence, location) are the ones a contradiction makes the issue Incorrect.",
            "enum": [
              "existence_or_event",
              "figure_or_dollar",
              "date_or_timeframe",
              "vote_or_official_action",
              "location_or_geography",
              "attribution_resident_demand",
              "background_context",
              "lean_annotation",
              "synthesis"
            ]
          },
          "claim_weight": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "description": "ids of the sources[] entries that ground this claim. Must resolve to top-level sources[].",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_extracts": {
            "type": "array",
            "minItems": 1,
            "description": "Verbatim text from the cited source(s) that states this claim. Each extract MUST appear as a substring of the retrieved_text_or_snapshot of one of the claim's source_ids (the QA spine enforces this). Strings, or objects carrying the verbatim text plus optional context.",
            "items": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["text"],
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "section_header": {
                      "type": "string",
                      "description": "Where in the source the verbatim text came from (e.g. a headline or section title), giving the judge context."
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Optional: which cited source this specific extract came from, when a claim cites more than one."
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "Source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_type",
          "retrieved_at",
          "retrieved_text_or_snapshot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": ["news", "government_website", "research", "poll", "advocacy_org"]
          },
          "url": {
            "type": ["string", "null"],
            "pattern": "^https?://"
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "article_type": {
            "type": ["string", "null"],
            "enum": [
              "reporting",
              "opinion",
              "editorial",
              "press_release",
              "government_communication",
              null
            ]
          },
          "article_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "retrieved_text_or_snapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        }
      }
    }
  }
}
