{
  "$schema": "../_schema/manifest.schema.json",
  "id": "meeting_briefing",
  "version": 15,
  "model": "sonnet",
  "max_turns": 200,
  "timeout_seconds": 3000,
  "runtime": {
    "max_thinking_tokens": 0
  },
  "scope": {
    "allowed_tables": [
      "goodparty_data_catalog.dbt.int__l2_nationwide_uniform_w_haystaq"
    ],
    "max_rows": 50000,
    "data_required_unless": {
      "field": "briefing_status",
      "values": ["awaiting_agenda", "no_meeting_found", "error"]
    }
  },
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["officialName", "state", "meetingDate"],
    "properties": {
      "officialName": {
        "type": "string",
        "minLength": 1,
        "description": "Full name of the elected official (e.g. \"Shekar Krishnan\")."
      },
      "state": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "2-letter state code (e.g. NY)."
      },
      "meetingDate": {
        "type": "string",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "description": "Target meeting date in YYYY-MM-DD. Required. The caller (gp-api) supplies this from the official's meeting_schedule. The agent does NOT discover the meeting date — it uses this value as the target and verifies the platform shows a meeting on that date."
      },
      "meetingTime": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
        "description": "Start time of the target meeting in 24-hour HH:MM (local time of meetingTimezone). Optional but recommended. When provided, the agent treats this as the source-of-truth meeting time and copies it through to the artifact's meeting_time field. When omitted, the agent reads the time from the streaming platform."
      },
      "meetingTimezone": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "description": "IANA timezone name for meetingTime (e.g. \"America/New_York\"). Optional but recommended. Pair with meetingTime."
      },
      "positionName": {
        "type": "string",
        "minLength": 1,
        "description": "The EO's position."
      },
      "l2DistrictType": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
        "description": "L2 voter file column for the official's district (e.g. City_Council_Commissioner_District). ASCII identifier shape — interpolated as a backtick-quoted column name in Databricks SQL. Omit for at-large officials."
      },
      "l2DistrictName": {
        "type": "string",
        "minLength": 1,
        "description": "L2 district value to match (e.g. \"25\"). Required if l2DistrictType is set."
      },
      "knownAgendaLocation": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "description": "Optional hint from a prior run describing where the agenda packet was last found. Usually a URL to the city's meetings index, the streaming platform's calendar page, or a CDN parent path. May include prose navigation notes when no single URL captures it. The agent SHOULD try this as channel 0 in Step 2's discovery before falling through to channels 1-4; if the hint is stale, continue with normal discovery — do not bail."
      },
      "agendaPacketUrl": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048,
        "pattern": "^https?://",
        "description": "Optional URL to the agenda packet the user pasted in the briefings UI. The agent fetches via pmf_runtime.pdf.download() and skips channel-1-4 discovery. This is always the user's own permanent URL — never a presigned S3 URL. Cite the URL verbatim as the permanent source in run_metadata.agenda_packet_url and sources[]. When the user uploaded a file instead of pasting a URL, this field is absent and the file is pre-staged at /workspace/input/agenda.pdf (the runner fetches it via the broker before the agent boots); the pre-staged file takes precedence over agentic discovery just like agendaPacketUrl does."
      }
    }
  },
  "output_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MeetingBriefingOutput",
    "description": "v2 artifact schema for the meeting_briefing experiment. Drop into manifest.json's output_schema field at port time.",
    "oneOf": [
      {
        "title": "MeetingBriefingFull",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "briefing_type",
          "briefing_status",
          "generated_at",
          "official_name",
          "meeting_name",
          "location",
          "meeting_date",
          "meeting_time",
          "meeting_timezone",
          "estimated_read_minutes",
          "executive_summary",
          "run_metadata",
          "items",
          "claims",
          "sources",
          "required_data_points",
          "disclosure"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1,
            "description": "Experiment id, echoed from PARAMS."
          },
          "briefing_type": {
            "type": "string",
            "enum": [
              "city_council_meeting",
              "county_legislature_meeting",
              "school_board_meeting"
            ],
            "description": "Self-identification of the briefing kind."
          },
          "briefing_status": {
            "type": "string",
            "enum": ["briefing_ready", "agenda_provided_by_user"],
            "description": "Full briefing produced. UI renders normal briefing."
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC timestamp when the briefing was generated."
          },
          "official_name": {
            "type": "string",
            "minLength": 1
          },
          "meeting_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "Official name of the meeting body as the source refers to it (e.g. 'City Council', 'Planning Board'). Used as the list-row title in the candidate dashboard. Mirrors meeting_schedule.meeting_name when a schedule exists."
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "description": "Customary location for the meeting (e.g. 'City Hall Council Chambers, 200 Main St'). Required-but-may-be-empty: emit an empty string when no source for the run mentions a venue (e.g. a user-supplied agenda PDF that lacks a header). Otherwise prefer the room-level location and fall back to building + street address when only the building is given."
          },
          "meeting_date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD. For agenda_provided_by_user or awaiting_agenda runs, this is the target meeting date; for no_meeting_found it may be an estimated next date."
          },
          "meeting_time": {
            "type": "string",
            "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
            "description": "Start time of the meeting in 24-hour HH:MM format, in the local timezone given by meeting_timezone. Briefings own this independently of meeting_schedule so the row is self-sufficient."
          },
          "meeting_timezone": {
            "type": "string",
            "minLength": 1,
            "description": "IANA timezone name for meeting_time (e.g. 'America/Chicago'). Use the timezone the governing body publishes the meeting in, not UTC."
          },
          "estimated_read_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "executive_summary": {
            "$ref": "#/definitions/executive_summary"
          },
          "run_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agenda_packet_url",
              "source_bundle_retrieved_at",
              "discovered_agenda_location"
            ],
            "properties": {
              "agenda_packet_url": {
                "type": ["string", "null"],
                "description": "Permanent URL to the agenda packet. May be null when briefing_status is awaiting_agenda or no_meeting_found."
              },
              "discovered_agenda_location": {
                "type": ["string", "null"],
                "maxLength": 2000,
                "description": "Best current prose describing where future agenda packets will likely be found for this body, persisted by gp-api as a hint for subsequent runs. Prefer a URL to the PARENT page that lists meetings (e.g. the streaming platform's calendar, the city's agendas index, a CDN directory) — not the deep link to today's specific packet PDF. Prose with multi-step navigation is allowed when no single URL captures it. Emit even on awaiting_agenda / no_meeting_found runs when the parent page was still reachable; set to null only when no plausible future-run starting point exists."
              },
              "source_bundle_retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "briefing_version": {
                "type": "string"
              },
              "run_decisions": {
                "type": "array",
                "description": "Curated trail of agent judgment calls. Separate from conversation/log.txt; this is QA-facing.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["timestamp", "decision", "reason"],
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "decision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/item"
            }
          },
          "claims": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/definitions/claim"
            },
            "description": "May be empty when briefing_status is awaiting_agenda or no_meeting_found. Capped at 200 to bound the validator's O(claims × sources × extracts) substring scan."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/source"
            }
          },
          "required_data_points": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/required_data_point"
            }
          },
          "disclosure": {
            "type": "string",
            "minLength": 1,
            "description": "Required verbatim disclaimer per required_disclosure.md."
          }
        }
      },
      {
        "title": "MeetingBriefingPlaceholder",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "experiment_id",
          "briefing_type",
          "briefing_status",
          "generated_at",
          "official_name",
          "meeting_name",
          "location",
          "meeting_date",
          "meeting_time",
          "meeting_timezone",
          "estimated_read_minutes",
          "executive_summary",
          "run_metadata",
          "items",
          "claims",
          "sources",
          "required_data_points",
          "disclosure"
        ],
        "properties": {
          "experiment_id": {
            "type": "string",
            "minLength": 1,
            "description": "Experiment id, echoed from PARAMS."
          },
          "briefing_type": {
            "type": "string",
            "enum": [
              "city_council_meeting",
              "county_legislature_meeting",
              "school_board_meeting"
            ],
            "description": "Self-identification of the briefing kind."
          },
          "briefing_status": {
            "type": "string",
            "enum": ["awaiting_agenda", "no_meeting_found", "error"],
            "description": "Early-exit / placeholder artifact. UI renders a check-back state. Use 'awaiting_agenda' when the meeting is on the calendar but the agenda packet has not been published. Use 'no_meeting_found' when the streaming platform shows no meeting of the official's body on the caller-supplied PARAMS.meetingDate (stale schedule signal). Use 'error' for unrecoverable run failures \u2014 populate run_metadata.run_decisions[] with the diagnostic trail."
          },
          "generated_at": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 UTC timestamp when the briefing was generated."
          },
          "official_name": {
            "type": "string",
            "minLength": 1
          },
          "meeting_name": {
            "type": "string",
            "maxLength": 200,
            "description": "Official name of the meeting body (e.g. 'City Council'). Required-but-may-be-empty: populate when the meeting is identified (awaiting_agenda), emit an empty string when no_meeting_found or error."
          },
          "location": {
            "type": "string",
            "maxLength": 300,
            "description": "Customary location for the meeting. Required-but-may-be-empty: populate when the meeting is identified (awaiting_agenda), emit an empty string when no_meeting_found or error."
          },
          "meeting_date": {
            "type": "string",
            "format": "date",
            "description": "YYYY-MM-DD. For agenda_provided_by_user or awaiting_agenda runs, this is the target meeting date; for no_meeting_found it may be an estimated next date."
          },
          "meeting_time": {
            "type": "string",
            "pattern": "^(([01][0-9]|2[0-3]):[0-5][0-9])?$",
            "description": "Start time of the meeting in 24-hour HH:MM format, in the local timezone given by meeting_timezone. Required-but-may-be-empty: populate when the meeting is identified (awaiting_agenda), emit an empty string when no_meeting_found or error."
          },
          "meeting_timezone": {
            "type": "string",
            "maxLength": 64,
            "description": "IANA timezone name for meeting_time (e.g. 'America/Chicago'). Required-but-may-be-empty: populate when the meeting is identified, emit an empty string when no_meeting_found or error."
          },
          "estimated_read_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "executive_summary": {
            "$ref": "#/definitions/executive_summary"
          },
          "run_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agenda_packet_url",
              "source_bundle_retrieved_at",
              "discovered_agenda_location"
            ],
            "properties": {
              "agenda_packet_url": {
                "type": ["string", "null"],
                "description": "Permanent URL to the agenda packet. May be null when briefing_status is awaiting_agenda or no_meeting_found."
              },
              "discovered_agenda_location": {
                "type": ["string", "null"],
                "maxLength": 2000,
                "description": "Best current prose describing where future agenda packets will likely be found for this body, persisted by gp-api as a hint for subsequent runs. Prefer a URL to the PARENT page that lists meetings (e.g. the streaming platform's calendar, the city's agendas index, a CDN directory) — not the deep link to today's specific packet PDF. Prose with multi-step navigation is allowed when no single URL captures it. Emit even on awaiting_agenda / no_meeting_found runs when the parent page was still reachable; set to null only when no plausible future-run starting point exists."
              },
              "source_bundle_retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "briefing_version": {
                "type": "string"
              },
              "run_decisions": {
                "type": "array",
                "description": "Curated trail of agent judgment calls. Separate from conversation/log.txt; this is QA-facing.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["timestamp", "decision", "reason"],
                  "properties": {
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "decision": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/definitions/placeholder_item"
            }
          },
          "claims": {
            "type": "array",
            "maxItems": 0,
            "description": "Always empty for placeholder/early-exit artifacts."
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/source"
            }
          },
          "required_data_points": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/required_data_point"
            }
          },
          "disclosure": {
            "type": "string",
            "minLength": 1,
            "description": "Required verbatim disclaimer per required_disclosure.md."
          }
        }
      }
    ],
    "definitions": {
      "executive_summary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lead_in", "items"],
        "properties": {
          "lead_in": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Single framing sentence at the top of the briefing. For briefing_ready artifacts: defaults to 'The following items on your agenda require action and/or have a vote:' (with trailing colon when items follow). For awaiting_agenda / no_meeting_found / error: a check-back or no-meeting message; items[] is empty."
          },
          "items": {
            "type": "array",
            "maxItems": 5,
            "description": "One entry per featured item in top-level items[], in the same order. Empty when no items qualify as featured (and for placeholder briefing_status values).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "title", "overview"],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^item_[0-9]{3}$",
                  "description": "Must resolve to an entry in top-level items[] with tier='featured'. UI uses this to link the entry to the corresponding deep-dive panel."
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "description": "Item title shown before the em-dash. Must verbatim equal items[item_id].title (denormalized for renderer convenience)."
                },
                "overview": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300,
                  "description": "One-sentence distillation of items[item_id].display.summary (the Step 9 Overview) — same facts, tighter framing."
                },
                "priority_id": {
                  "type": "string"
                },
                "community_issue_id": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item_number",
          "title",
          "tier",
          "vote_required",
          "tier_reason",
          "display",
          "research"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^item_[0-9]{3}$"
          },
          "item_number": {
            "type": ["string", "null"],
            "description": "Agenda item number as a string (e.g. '5F'). Set to null only for the single placeholder item emitted when briefing_status is awaiting_agenda or no_meeting_found."
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": ["featured", "queued", "standard"]
          },
          "vote_required": {
            "type": "boolean"
          },
          "tier_reason": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Free-form short snake_case reasons explaining the tier assignment. Preferred values for the common cases: 'vote_required', 'public_position_required', 'budget_threshold', 'constituent_alignment', 'procedural', 'ceremonial', 'consent_routine', 'first_reading_only', 'received_and_filed_or_callup', 'land_use_referral', 'out_of_district', 'symbolic_resolution', 'placeholder'. Agent may use a domain-specific reason when none of the preferred values fit, but reuse preferred values when they apply (do not invent 'procedural_minutes' when 'procedural' already covers it)."
          },
          "display": {
            "$ref": "#/definitions/display"
          },
          "research": {
            "$ref": "#/definitions/research"
          }
        }
      },
      "display": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "constituent_sentiment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/display_constituent_sentiment"
              }
            ]
          },
          "recent_news": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "$ref": "#/definitions/recent_news_entry"
                }
              }
            ]
          },
          "budget_impact": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/budget_impact"
              }
            ]
          },
          "talking_points": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              {
                "type": "array",
                "minItems": 3,
                "maxItems": 5,
                "items": {
                  "$ref": "#/definitions/talking_point"
                }
              }
            ]
          }
        }
      },
      "talking_point": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "why"],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "description": "The bullet itself — the ask, question, or framing to bring into the room."
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "description": "Rationale for the talking point: why it matters strategically, whether raising it risks making the official look uninformed, and how to handle the likely response."
          }
        }
      },
      "display_constituent_sentiment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "summary",
          "haystaq_column",
          "mean_score",
          "score_direction",
          "voter_count",
          "haystaq_status",
          "source_ids"
        ],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": ["string", "null"]
          },
          "district_note": {
            "type": ["string", "null"]
          },
          "haystaq_column": {
            "type": "string",
            "pattern": "^hs_[a-z0-9_]+$"
          },
          "mean_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "score_direction": {
            "type": "string",
            "minLength": 1,
            "description": "Short string describing what high values represent. Derived from the catalog entry's `meaning` field (e.g. \"supports gun control\")."
          },
          "voter_count": {
            "type": "integer",
            "minimum": 0
          },
          "haystaq_status": {
            "type": "string",
            "enum": ["ok", "no_match", "city_mismatch", "no_column"]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "References to ids in the top-level sources[] list that back this section as a whole. Required-but-may-be-empty: emit [] when no specific source cites the section (rare for haystaq sentiment, which should reference the Haystaq source entry). Authors must not fabricate citations to pad this list."
          }
        }
      },
      "recent_news_entry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headline",
          "publication",
          "article_type",
          "publication_date",
          "url"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "type": "string",
            "minLength": 1
          },
          "article_type": {
            "type": "string",
            "enum": [
              "reporting",
              "opinion",
              "editorial",
              "press_release",
              "government_communication"
            ]
          },
          "publication_date": {
            "type": "string",
            "format": "date",
            "description": "Required, non-nullable. Must be within 60 days of PARAMS.meetingDate (see instruction.md Step 11) — the qa/ gate rejects entries older than that or missing this field."
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "source_id": {
            "type": ["string", "null"],
            "description": "Optional cross-reference to a sources[] entry id; populate when the article also appears in sources[]."
          }
        }
      },
      "budget_impact": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "figures", "source_ids"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "figures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value", "source_id"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "References to ids in the top-level sources[] list that back this section as a whole. Complements per-figure figures[].source_id (which cites the specific document a number was extracted from); this section-level list cites the section overall and renders as inline source pills in the UI. Required-but-may-be-empty: emit [] when the section's narrative draws solely from figures whose source_id already covers it."
          }
        }
      },
      "research": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw_context", "full_treatment"],
        "properties": {
          "raw_context": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/raw_context_chunk"
            }
          },
          "full_treatment": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/full_treatment"
              }
            ]
          }
        }
      },
      "raw_context_chunk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chunk_id",
          "item_id",
          "item_title",
          "tier",
          "source_id",
          "pages",
          "text"
        ],
        "properties": {
          "chunk_id": {
            "type": "string",
            "minLength": 1
          },
          "item_id": {
            "type": "string",
            "pattern": "^item_[0-9]{3}$"
          },
          "item_title": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "enum": ["featured", "queued", "standard"]
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "section_heading": {
            "type": ["string", "null"]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "full_treatment": {
        "type": "object",
        "additionalProperties": false,
        "required": ["haystaq_detail", "news_articles", "budget_detail"],
        "properties": {
          "haystaq_detail": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/haystaq_detail"
              }
            ]
          },
          "news_articles": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/news_article"
                }
              }
            ]
          },
          "budget_detail": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/definitions/budget_detail"
              }
            ]
          }
        }
      },
      "haystaq_detail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["haystaq_status", "haystaq_column"],
        "properties": {
          "haystaq_status": {
            "type": "string",
            "enum": ["ok", "no_match", "city_mismatch", "no_column"]
          },
          "haystaq_column": {
            "type": ["string", "null"],
            "pattern": "^hs_[a-z0-9_]+$"
          },
          "city_mean_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "district_mean_score": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "city_voter_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "district_voter_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "complementary_field": {
            "type": ["string", "null"]
          },
          "query_executed": {
            "type": ["string", "null"]
          }
        }
      },
      "news_article": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headline",
          "publication",
          "article_type",
          "url",
          "body_text"
        ],
        "properties": {
          "headline": {
            "type": "string",
            "minLength": 1
          },
          "publication": {
            "type": "string",
            "minLength": 1
          },
          "article_type": {
            "type": "string",
            "enum": [
              "reporting",
              "opinion",
              "editorial",
              "press_release",
              "government_communication"
            ]
          },
          "publication_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "body_text": {
            "type": "string"
          }
        }
      },
      "budget_detail": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figures"],
        "properties": {
          "figures": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value", "verbatim_extract"],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "verbatim_extract": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      },
      "claim": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "item_id",
          "section",
          "claim_text",
          "claim_type",
          "claim_weight",
          "source_extracts",
          "source_ids",
          "required_source_type",
          "route_if_unsupported"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^claim_[0-9]{3}$"
          },
          "item_id": {
            "type": "string",
            "pattern": "^item_[0-9]{3}$"
          },
          "section": {
            "type": "string",
            "enum": [
              "overview",
              "constituent_sentiment",
              "recent_news",
              "budget_impact",
              "talking_points"
            ]
          },
          "claim_text": {
            "type": "string",
            "minLength": 1
          },
          "claim_type": {
            "type": "string",
            "enum": [
              "budget_number",
              "vote_count",
              "legal_citation",
              "staff_recommendation",
              "constituent_sentiment",
              "news_context",
              "historical_context",
              "inferred"
            ]
          },
          "claim_weight": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "source_extracts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "required_source_type": {
            "type": "string",
            "enum": [
              "agenda_packet",
              "government_website",
              "news",
              "haystaq",
              "none"
            ]
          },
          "route_if_unsupported": {
            "type": "string",
            "enum": ["block_release", "omit_claim", "flag_as_inferred"]
          }
        }
      },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_type",
          "retrieved_at",
          "retrieved_text_or_snapshot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": ["string", "null"],
            "pattern": "^https?://"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "agenda_packet",
              "news",
              "government_website",
              "campaign",
              "haystaq"
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "retrieved_text_or_snapshot": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          },
          "page_number": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "section_heading": {
            "type": ["string", "null"]
          },
          "article_date": {
            "type": ["string", "null"],
            "format": "date"
          },
          "article_type": {
            "type": ["string", "null"],
            "enum": [
              "reporting",
              "opinion",
              "editorial",
              "press_release",
              "government_communication",
              null
            ]
          },
          "publisher": {
            "type": ["string", "null"]
          },
          "haystaq_column": {
            "type": ["string", "null"]
          },
          "score_value": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100
          },
          "district_voters_n": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "specific_claim_found": {
            "type": ["string", "null"]
          }
        }
      },
      "required_data_point": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope", "required", "citation_required"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": ["all_items", "featured_queued", "featured"]
          },
          "required": {
            "type": "boolean"
          },
          "citation_required": {
            "type": "boolean"
          },
          "allowed_source_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "agenda_packet",
                "news",
                "government_website",
                "campaign",
                "haystaq"
              ]
            }
          },
          "skip_reasons_allowed": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "placeholder_item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "item_number",
          "title",
          "tier",
          "vote_required",
          "tier_reason",
          "display",
          "research"
        ],
        "properties": {
          "id": {
            "type": "string",
            "const": "item_001"
          },
          "item_number": {
            "type": "null"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "type": "string",
            "const": "standard"
          },
          "vote_required": {
            "type": "boolean",
            "const": false
          },
          "tier_reason": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "const": "placeholder"
            }
          },
          "display": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary"],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "constituent_sentiment": {
                "type": "null"
              },
              "recent_news": {
                "type": "null"
              },
              "budget_impact": {
                "type": "null"
              },
              "talking_points": {
                "type": "null"
              }
            }
          },
          "research": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw_context", "full_treatment"],
            "properties": {
              "raw_context": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/definitions/raw_context_chunk"
                }
              },
              "full_treatment": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  }
}
