{
  "mcpServers": {
    "grafana": {
      "command": "sh",
      "args": [
        "-c",
        "exec bash \"$(git rev-parse --show-toplevel)/scripts/mcp/grafana.sh\""
      ],
      "env": {
        "GRAFANA_URL": "https://goodparty.grafana.net"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--headless", "--isolated"]
    },
    "clickup": {
      "type": "http",
      "url": "https://mcp.clickup.com/mcp"
    },
    "amplitude": {
      "type": "http",
      "url": "https://mcp.amplitude.com/mcp"
    }
  }
}
